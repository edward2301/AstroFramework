---
/**
 * 图文行：左（或右）图 + 右侧标题、正文、要点列表。
 *
 * 图文交替构成阅读动线（Z 字），比连续大段文字更容易扫读；
 * reverse=true 时图在右侧，用于相邻两行交替。
 */
interface Props {
  title: string;
  body: string;
  points?: string[];
  image: string;
  imageAlt: string;
  reverse?: boolean;
}

const { title, body, points = [], image, imageAlt, reverse = false } = Astro.props;
---

<section class:list={['feature-row', reverse && 'is-reversed']}>
  <figure class="feature-row-media">
    <img src={image} alt={imageAlt} width="1200" height="742" loading="lazy" decoding="async" />
  </figure>

  <div class="feature-row-body">
    <h2>{title}</h2>
    <p>{body}</p>
    {
      points.length > 0 && (
        <ul>
          {points.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .feature-row {
    display: grid;
    /* 图列固定窄宽（装饰图，不是产品主图），文字列吃剩余；顶部对齐避免短文本漂浮在图片中线 */
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
    margin-bottom: var(--space-7);
  }

  .feature-row:last-child {
    margin-bottom: 0;
  }

  .feature-row-media {
    margin: 0;
  }

  .feature-row-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.618;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-sunken);
  }

  .feature-row-body h2 {
    margin-bottom: var(--space-3);
  }

  .feature-row-body p {
    max-width: var(--measure);
    color: var(--color-muted);
  }

  .feature-row-body ul {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .feature-row-body li {
    position: relative;
    padding-left: 16px;
    font-size: var(--fs-sm);
    color: var(--color-text);
  }

  /* 要点标记：6px 石墨小方块（无圆角、无蓝色） */
  .feature-row-body li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    background: var(--color-data);
  }

  /* 交替：文字在左（宽列）、图在右（窄列）——列宽随之互换，
     否则图会落进 1fr 宽列变成大图（显式列位，不用 order） */
  .feature-row.is-reversed {
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
  }

  .is-reversed .feature-row-media {
    grid-column: 2;
    grid-row: 1;
  }

  .is-reversed .feature-row-body {
    grid-column: 1;
    grid-row: 1;
  }

  @media (max-width: 1024px) {
    .feature-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .feature-row.is-reversed {
      grid-template-columns: minmax(0, 1fr);
    }

    .is-reversed .feature-row-media,
    .is-reversed .feature-row-body {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
