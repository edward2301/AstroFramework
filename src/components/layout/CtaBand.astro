---
/**
 * 页尾转化横条：石墨 full-bleed + 内部 container。
 * 次级动作（如规格书下载）通过默认 slot 传入，样式用 .btn .btn--on-dark。
 */
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { ROUTES } from '../../data/routes';

interface Props {
  locale: Locale;
  /** 覆盖按钮文案（如品类页的「为 XX 索取报价」）；缺省用通用询价文案 */
  label?: string;
}

const { locale, label } = Astro.props;
const dict = t(locale);
---

<div class="cta-band">
  <div class="container cta-band-inner">
    <p class="cta-title">{dict.cta.title}</p>
    <div class="cta-actions">
      <a class="btn btn--primary" href={localizePath(locale, ROUTES.quote)}>{label ?? dict.nav.quote}</a>
      <slot />
    </div>
  </div>
</div>

<style>
  .cta-band {
    background: var(--color-ink);
    margin-top: var(--space-section);
    /* 抵消页脚的 margin-top：黑带与黑页脚贴合，形成完整石墨收尾，
       不被一段白空割裂；无 CtaBand 的页面页脚 margin 照常生效 */
    margin-bottom: calc(-1 * var(--space-section));
    padding: var(--space-6) 0;
    /* 与页脚贴合但留一道细线：暗示「转化区 → 导航区」的层级，与 footer-bottom 分隔线同款 */
    border-bottom: 1px solid rgb(255 255 255 / 14%);
  }

  .cta-band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .cta-title {
    margin: 0;
    max-width: 60ch;
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-on-dark);
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
</style>
