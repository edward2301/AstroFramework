---
/**
 * 详情页底部的询价横条：浅蓝底 + 品牌色按钮。
 * 次级动作（如规格书下载）通过默认 slot 传入，样式随各 Body 自带。
 */
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { ROUTES } from '../../data/routes';

interface Props {
  locale: Locale;
  /** 覆盖按钮文案（如品类页的「为 XX 索取报价」）；缺省用通用询价文案 */
  label?: string;
}

const { locale, label } = Astro.props;
const dict = t(locale);
---

<div class="cta-band">
  <p class="cta-title">{dict.cta.title}</p>
  <div class="cta-actions">
    <a class="cta-btn" href={localizePath(locale, ROUTES.quote)}>{label ?? dict.nav.quote}</a>
    <slot />
  </div>
</div>

<style>
  .cta-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding: var(--space-5) var(--space-6);
    background: var(--color-brand-soft);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-brand);
    border-radius: var(--radius);
  }

  .cta-title {
    margin: 0;
    font-weight: 600;
    font-size: var(--fs-h3);
    color: var(--color-text);
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cta-btn {
    display: inline-block;
    padding: 10px 22px;
    background: var(--color-brand);
    color: #fff;
    border-radius: var(--radius);
    font-size: var(--fs-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .cta-btn:hover {
    background: var(--color-brand-hover);
    color: #fff;
    text-decoration: none;
  }
</style>
