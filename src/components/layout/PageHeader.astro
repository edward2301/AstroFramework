---
/**
 * 内页页头：full-bleed 浅色带，面包屑 + h1 + lead + meta + actions。
 *
 * 必须放在 `.section` 之外（紧贴页头下方），内部自带 container；
 * 放进 `.section > .container` 会出现双重内缩。
 */
import Breadcrumb from '../seo/Breadcrumb.astro';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/routing';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  title: string;
  /** 标题下的一行概述 */
  lead?: string;
  /** 一行数据摘要（型号数、参数数、停产数），tabular 数字 */
  meta?: string;
  /** 横幅内宽度：wide 1280 / narrow 880 */
  width?: 'wide' | 'narrow';
}

const { locale, crumbs, title, lead, meta, width = 'wide' } = Astro.props;
const dict = t(locale);
---

<div class="page-header">
  <div class:list={['container', 'page-header-inner', width === 'narrow' && 'page-header-inner--narrow']}>
    <div class="page-header-text">
      <Breadcrumb items={crumbs} label={dict.breadcrumb.aria} />
      <h1>{title}</h1>
      {lead && <p class="page-header-lead">{lead}</p>}
      {meta && <p class="page-header-meta">{meta}</p>}
    </div>
    <div class="page-header-actions">
      <slot name="actions" />
    </div>
  </div>
</div>

<style>
  .page-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-6) 0;
  }

  .page-header-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .page-header-inner--narrow {
    max-width: var(--container-narrow);
  }

  .page-header-text {
    min-width: 0;
  }

  .page-header h1 {
    margin: var(--space-2) 0 0;
    max-width: 22ch;
    font-size: var(--fs-h1);
    font-weight: 600;
    color: var(--color-ink);
  }

  .page-header-lead {
    margin: var(--space-3) 0 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  .page-header-meta {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .page-header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .page-header-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
