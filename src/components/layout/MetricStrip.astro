---
/**
 * 指标条：数量由数据决定（auto-fit），用于替代「形容词式的自我介绍」。
 *
 * 数字用 ink/反白、说明用次要灰；铜色顶线是唯一的数据强调色。
 * tone="light" 用于白底页面，tone="deep" 用于深色带（石墨底反白）。
 */
interface Props {
  items: { value: string; label: string }[];
  tone?: 'light' | 'deep';
}

const { items, tone = 'light' } = Astro.props;
---

<ul class:list={['metrics', `metrics--${tone}`]}>
  {
    items.map((it) => (
      <li>
        <strong>{it.value}</strong>
        <span>{it.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-5);
  }

  .metrics li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-data);
  }

  .metrics strong {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    line-height: 1.1;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .metrics span {
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }

  /* 深色带：反白 */
  .metrics--deep li {
    border-left-color: rgb(255 255 255 / 25%);
  }

  .metrics--deep strong {
    color: #fff;
  }

  .metrics--deep span {
    color: var(--color-on-dark-muted);
  }
</style>
