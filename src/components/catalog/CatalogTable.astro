---
/**
 * 全型号目录表（产品总览页）。
 *
 * 行 = 型号，列固定为 Model / Category / Key parameters / Status / Details。
 * 不同品类的 keyParams 键名不一致，所以参数收在一个单元格里按 2 列网格排列，
 * 不按品类拆动态列（列数一变整张表就错位）。
 *
 * 所有行都进首屏 HTML：产品总览页的筛选与搜索只切 `hidden`，不重新渲染。
 * 行上带 data-category / data-search，供页面内联脚本过滤；无 JS 时全行可见。
 * 外层 .table-scroll 保证窄屏只在表内横滚，页面本身不溢出；≤768 行转为卡片，无横滚。
 */
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath } from '../../data/routes';

interface Props {
  locale: Locale;
  models: {
    id: string;
    categoryId: string;
    categoryName: string;
    code: string;
    name: string;
    status: 'active' | 'discontinued';
    keyParams: { k: string; v: string }[];
    image?: string;
  }[];
  /** 滚动区域的可达名（如「产品目录 — 全部型号」） */
  scrollLabel: string;
}

type ModelRow = Props['models'][number];

const { locale, models, scrollLabel } = Astro.props;
const dict = t(locale);
/** 中英分号宽度不同，与型号卡保持同一规则 */
const colon = locale === 'zh' ? '：' : ': ';

/** 行级搜索索引：编码 + 名称 + 品类 + 全部参数键值，统一小写 */
const searchIndex = (m: ModelRow) =>
  [m.code, m.name, m.categoryName, ...m.keyParams.flatMap((p) => [p.k, p.v])]
    .join(' ')
    .toLowerCase();
---

<div
  class="table-scroll catalog-scroll"
  role="region"
  aria-label={scrollLabel}
  tabindex="0"
  data-catalog-table
>
  <table class="data-table catalog">
    <caption class="visually-hidden">{scrollLabel}</caption>
    <thead>
      <tr>
        <th class="col-model" scope="col">{dict.products.modelColumn}</th>
        <th class="col-category" scope="col">{dict.products.categoryColumn}</th>
        <th class="col-params" scope="col">{dict.products.keyParamsColumn}</th>
        <th class="col-status" scope="col">{dict.products.statusColumn}</th>
        <th class="col-details" scope="col">{dict.products.detailsColumn}</th>
      </tr>
    </thead>
    <tbody>
      {
        models.map((m) => {
          const href = localizePath(locale, detailPath.model(m.id));
          const discontinued = m.status === 'discontinued';
          return (
            <tr
              class:list={[discontinued && 'is-discontinued']}
              data-model-row
              data-category={m.categoryId}
              data-search={searchIndex(m)}
            >
              <th class="cell-model" scope="row">
                <div class="model-stack">
                  {m.image && (
                    <img
                      class="model-thumb"
                      src={m.image}
                      alt={`${m.code} ${m.name}`}
                      width="48"
                      height="30"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <a class="model-link" href={href}>
                    <span class="mono model-code">{m.code}</span>
                    <span class="model-name">{m.name}</span>
                  </a>
                </div>
              </th>
              <td class="cell-category" data-label={dict.products.categoryColumn}>
                <a class="category-link" href={localizePath(locale, detailPath.category(m.categoryId))}>
                  {m.categoryName}
                </a>
              </td>
              <td class="cell-params" data-label={dict.products.keyParamsColumn}>
                <dl class="param-list">
                  {m.keyParams.slice(0, 5).map((p) => (
                    <div class="param">
                      <dt>{p.k}{colon}</dt>
                      <dd>{p.v}</dd>
                    </div>
                  ))}
                </dl>
              </td>
              <td class="cell-status" data-label={dict.products.statusColumn}>
                <span
                  class:list={['status-badge', discontinued && 'status-badge--discontinued']}
                >
                  {discontinued ? dict.category.discontinued : dict.products.active}
                </span>
              </td>
              <td class="cell-details">
                <a class="details-link" href={href}>
                  {dict.products.detailsColumn}
                  <span aria-hidden="true">→</span>
                </a>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .catalog-scroll {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  /* 最小宽度触发表内横滚：窄屏不压扁参数列，页面容器不随之溢出 */
  .catalog {
    min-width: 960px;
  }

  .catalog th,
  .catalog td {
    padding: 10px var(--space-3);
    vertical-align: middle;
    border-bottom: 1px solid var(--color-border);
  }

  .catalog thead th {
    white-space: nowrap;
  }

  .catalog tbody tr:last-child th,
  .catalog tbody tr:last-child td {
    border-bottom: 0;
  }

  /* 行标题是型号名，不是表头：字重交给 .model-code，别继承 thead 的粗体 */
  .catalog tbody th {
    font-weight: 400;
  }

  .catalog tbody tr:hover {
    background: var(--color-subtle);
  }

  /* 列宽：参数列吃掉剩余空间，状态与详情只占必要宽度 */
  .col-model {
    width: 30%;
  }

  .col-category {
    width: 15%;
  }

  .col-params {
    width: 37%;
  }

  .col-status {
    width: 10%;
  }

  .col-details {
    width: 8%;
  }

  .cell-model {
    min-width: 240px;
  }

  /* 图与文字并列；可点目标只有编码+名称链接（与型号卡约定一致） */
  .model-stack {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .model-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .model-link:hover {
    color: inherit;
    text-decoration: none;
  }

  .model-link:hover .model-code {
    color: var(--color-link);
  }

  /* 源图是黄金比（800×494）：48px 宽、按比例取高，零裁切 */
  .model-thumb {
    display: block;
    flex: 0 0 48px;
    width: 48px;
    height: auto;
    aspect-ratio: 1.618;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-subtle);
  }

  /* 字重与颜色走全局 .model-code/.model-name；这里只补表格语境的字号与行高 */
  .model-code {
    font-size: var(--fs-sm);
  }

  .model-name {
    font-size: var(--fs-sm);
    line-height: var(--lh-data);
  }

  /* 参数：5 组键值按 2 列网格紧凑排布，键值同行、过长自然折行 */
  .param-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px var(--space-5);
    margin: 0;
  }

  .param {
    min-width: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-data);
  }

  .param dt,
  .param dd {
    display: inline;
    margin: 0;
  }

  .param dt {
    color: var(--color-muted);
  }

  .param dd {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  /* 状态：1px 细线小徽标；在售用实心方点，停产用空心方点 */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text);
  }

  .status-badge::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--color-data);
  }

  .status-badge--discontinued {
    border-color: var(--color-border-soft);
    color: var(--color-muted);
  }

  .status-badge--discontinued::before {
    background: transparent;
    border: 1px solid var(--color-border-strong);
  }

  .details-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-sm);
    white-space: nowrap;
  }

  /* 移动/平板端：表格内的 Category / Details 链接补到 44px 触控高度 */
  @media (max-width: 1024px) {
    .category-link,
    .details-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .category-link {
      min-width: 44px;
    }
  }

  /* 停产行整体降对比度，但仍可读、可点 */
  .is-discontinued .model-thumb {
    opacity: 0.6;
  }

  .is-discontinued .model-name,
  .is-discontinued .param dd {
    color: var(--color-muted);
  }

  /*
   * 移动端卡片化：≤768 行转为卡片，去掉表内横滚。
   * 列名由 td[data-label] 生成；表头隐藏，行内 hidden 过滤态必须显式恢复 display:none。
   */
  @media (max-width: 768px) {
    .catalog-scroll {
      border: 0;
      background: transparent;
    }

    .catalog {
      min-width: 0;
    }

    .catalog thead {
      display: none;
    }

    .catalog tbody tr {
      display: block;
      margin-bottom: var(--space-4);
      padding: var(--space-4);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
    }

    .catalog tbody tr:last-child {
      margin-bottom: 0;
    }

    .catalog tbody tr[hidden] {
      display: none;
    }

    .catalog tbody th,
    .catalog tbody td {
      display: block;
      width: auto;
      min-width: 0;
      padding: 0;
      border-bottom: 0;
    }

    .catalog tbody td[data-label]::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      font-size: var(--fs-xs);
      letter-spacing: var(--ls-wide);
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .cell-model {
      margin-bottom: var(--space-3);
    }

    .cell-params .param-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .cell-status {
      margin-top: var(--space-3);
    }

    .cell-details {
      margin-top: var(--space-3);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
    }
  }
</style>
