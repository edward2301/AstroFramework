---
/**
 * 全型号目录表（产品总览页）。
 *
 * 行 = 型号，列固定为 Model / Category / Key parameters / Status / Details。
 * 不同品类的 keyParams 键名不一致，所以参数收在一个单元格里按 2 列网格排列，
 * 不按品类拆动态列（列数一变整张表就错位）。
 *
 * 所有行都进首屏 HTML：产品总览页的筛选与搜索只切 `hidden`，不重新渲染。
 * 超出首屏（CATALOG_PAGE_SIZE）的行由服务端预置 `hidden`——首帧不参与布局、无闪烁；
 * 无 JS 时由下方 noscript CSS 展开为全量列表。
 * 行上带 data-category / data-search，供页面内联脚本过滤；无 JS 时全行可见。
 * 外层 .table-scroll 保证窄屏只在表内横滚，页面本身不溢出；≤768 行转为卡片，无横滚。
 */
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath } from '../../data/routes';
import { CATALOG_PAGE_SIZE } from '../../data/site';

interface Props {
  locale: Locale;
  models: {
    id: string;
    categoryId: string;
    categoryName: string;
    code: string;
    name: string;
    status: 'active' | 'discontinued';
    keyParams: { k: string; v: string }[];
    image?: string;
  }[];
  /** 滚动区域的可达名（如「产品目录 — 全部型号」） */
  scrollLabel: string;
}

type ModelRow = Props['models'][number];

const { locale, models, scrollLabel } = Astro.props;
const dict = t(locale);

/** 型号名已含编码时不再重复显示编码（按词边界、大小写不敏感） */
const nameContainsCode = (code: string, name: string) => {
  const escaped = code.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return new RegExp(`(^|[^a-z0-9])${escaped}([^a-z0-9]|$)`, 'i').test(name);
};
/** 中英分号宽度不同，与型号卡保持同一规则 */
const colon = locale === 'zh' ? '：' : ': ';

/** 行级搜索索引：编码 + 名称 + 品类 + 全部参数键值，统一小写 */
const searchIndex = (m: ModelRow) =>
  [m.code, m.name, m.categoryName, ...m.keyParams.flatMap((p) => [p.k, p.v])]
    .join(' ')
    .toLowerCase();
---

<div
  id="catalog-table"
  class="table-scroll catalog-scroll"
  role="region"
  aria-label={scrollLabel}
  tabindex="0"
  data-catalog-table
>
  <table class="data-table catalog">
    <caption class="visually-hidden">{scrollLabel}</caption>
    <thead>
      <tr>
        <th class="col-model" scope="col">{dict.products.modelColumn}</th>
        <th class="col-params" scope="col">{dict.products.keyParamsColumn}</th>
        <th class="col-status" scope="col">{dict.products.statusColumn}</th>
        <th class="col-details" scope="col">{dict.products.detailsColumn}</th>
      </tr>
    </thead>
    <tbody>
      {
        models.map((m, i) => {
          const href = localizePath(locale, detailPath.model(m.id));
          const discontinued = m.status === 'discontinued';
          const lazy = i >= CATALOG_PAGE_SIZE;
          return (
            <tr
              class:list={[discontinued && 'is-discontinued']}
              data-model-row
              data-lazy-row={lazy || undefined}
              hidden={lazy || undefined}
              data-category={m.categoryId}
              data-search={searchIndex(m)}
            >
              <th class="cell-model" scope="row">
                <div class="model-stack">
                  {m.image && (
                    <img
                      class="model-thumb"
                      src={m.image}
                      alt={`${m.code} ${m.name}`}
                      width="800"
                      height="494"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="model-body">
                    <a class="model-link" href={href}>
                      {!nameContainsCode(m.code, m.name) && (
                        <span class="mono model-code">{m.code}</span>
                      )}
                      <span class="model-name">{m.name}</span>
                    </a>
                    <a class="category-link" href={localizePath(locale, detailPath.category(m.categoryId))}>
                      {m.categoryName}
                    </a>
                  </div>
                </div>
              </th>
              <td class="cell-params" data-label={dict.products.keyParamsColumn}>
                <dl class="param-list">
                  {m.keyParams.slice(0, 5).map((p) => (
                    <div class="param">
                      <dt>{p.k}{colon}</dt>
                      <dd>{p.v}</dd>
                    </div>
                  ))}
                </dl>
              </td>
              <td class="cell-status" data-label={dict.products.statusColumn}>
                <span
                  class:list={['status-badge', discontinued && 'status-badge--discontinued']}
                >
                  {discontinued ? dict.category.discontinued : dict.products.active}
                </span>
              </td>
              <td class="cell-details">
                <a class="details-link" href={href}>
                  {dict.products.detailsColumn}
                  <span aria-hidden="true">→</span>
                </a>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<noscript>
  <style>
    /* 无 JS：展开服务端预隐藏的行，隐藏加载入口 */
    .catalog tbody tr[data-lazy-row][hidden] {
      display: table-row;
    }

    .catalog-more {
      display: none !important;
    }

    @media (max-width: 768px) {
      .catalog tbody tr[data-lazy-row][hidden] {
        display: block;
      }
    }
  </style>
</noscript>

<style>
  .catalog-scroll {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  /* 最小宽度触发表内横滚：窄屏不压扁参数列，页面容器不随之溢出 */
  .catalog {
    min-width: 960px;
    /* 固定列宽：长型号名在单元格内换行，不会把参数列挤走 */
    table-layout: fixed;
  }

  .catalog th,
  .catalog td {
    padding: 10px var(--space-3);
    vertical-align: middle;
    border-bottom: 1px solid var(--color-border);
  }

  .catalog thead th {
    white-space: nowrap;
  }

  .catalog tbody tr:last-child th,
  .catalog tbody tr:last-child td {
    border-bottom: 0;
  }

  /* 行标题是型号名，不是表头：字重交给 .model-code，别继承 thead 的粗体 */
  .catalog tbody th {
    font-weight: 400;
  }

  .catalog tbody tr:hover {
    background: var(--color-subtle);
  }

  /* 四列：产品身份 | 参数（压缩给状态列让位）| 状态 | 详情 */
  .col-model {
    width: 25%;
  }

  .col-params {
    width: 57%;
  }

  .col-status {
    width: 11%;
  }

  .col-details {
    width: 7%;
  }

  .cell-model {
    min-width: 340px;
  }

  .col-status,
  .cell-status {
    text-align: center;
  }

  .col-details,
  .cell-details {
    text-align: center;
  }

  /* 图与文字并列；可点目标只有编码+名称链接（与型号卡约定一致） */
  .model-stack {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .model-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .model-link:hover {
    color: inherit;
    text-decoration: none;
  }

  .model-link:hover .model-code {
    color: var(--color-link);
  }

  .model-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .category-link {
    font-size: var(--fs-xs);
  }

  /* 源图是黄金比（800×494）：桌面 200px 宽（源图 1/4），按比例取高，零裁切 */
  .model-thumb {
    display: block;
    flex: 0 0 200px;
    width: 200px;
    height: auto;
    aspect-ratio: 1.618;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-subtle);
  }

  /* 型号名是行内主信息：加大字号与字重，编码退为辅助元数据 */
  .model-code {
    font-size: var(--fs-xs);
    color: var(--color-muted);
  }

  .model-name {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: var(--lh-data);
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .model-link:hover .model-name {
    color: var(--color-link);
  }

  /* 参数：5 组键值自适应排成一行；窄屏由媒体查询改单列 */
  .param-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2px var(--space-4);
    margin: 0;
  }

  .param {
    min-width: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-data);
  }

  .param dt,
  .param dd {
    display: inline;
    margin: 0;
  }

  .param dt {
    color: var(--color-muted);
  }

  .param dd {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  /* 状态：1px 细线小徽标；在售绿方点，非在售灰方点 */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-success);
  }

  .status-badge::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--color-success);
  }

  .status-badge--discontinued {
    border-color: var(--color-border-soft);
    color: var(--color-muted);
  }

  .status-badge--discontinued::before {
    background: var(--color-muted);
    border: 0;
  }

  .details-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 80px;
    padding: 0 var(--space-2);
    gap: 6px;
    font-size: var(--fs-sm);
    font-weight: 500;
    white-space: nowrap;
  }

  /* 平板带：缩略图降一档；左列固定 340px，参数列吃剩余宽度并自动排成 3–4 列 */
  @media (max-width: 1280px) {
    .model-thumb {
      flex: 0 0 160px;
      width: 160px;
    }

    .col-model {
      width: 340px;
    }

    .col-params {
      width: auto;
    }

    .col-status {
      width: 168px;
    }

    .col-details {
      width: 112px;
    }
  }

  /* 移动/平板端：表格内的 Category / Details 链接补到 44px 触控高度 */
  @media (max-width: 1024px) {
    .category-link,
    .details-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .category-link {
      min-width: 44px;
    }

    .cell-params .param-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 停产行整体降对比度，但仍可读、可点 */
  .is-discontinued .model-thumb {
    opacity: 0.6;
  }

  .is-discontinued .model-name,
  .is-discontinued .param dd {
    color: var(--color-muted);
  }

  /*
   * 移动端卡片化：≤768 行转为卡片，去掉表内横滚。
   * 列名由 td[data-label] 生成；表头隐藏，行内 hidden 过滤态必须显式恢复 display:none。
   */
  @media (max-width: 768px) {
    .catalog-scroll {
      border: 0;
      background: transparent;
    }

    .catalog {
      min-width: 0;
    }

    .catalog thead {
      display: none;
    }

    .catalog tbody tr {
      display: block;
      margin-bottom: var(--space-4);
      padding: var(--space-4);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
    }

    .catalog tbody tr:last-child {
      margin-bottom: 0;
    }

    .catalog tbody tr[hidden] {
      display: none;
    }

    .catalog tbody th,
    .catalog tbody td {
      display: block;
      width: auto;
      min-width: 0;
      padding: 0;
      border-bottom: 0;
    }

    .catalog tbody td[data-label]::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      font-size: var(--fs-xs);
      letter-spacing: var(--ls-wide);
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .cell-model {
      margin-bottom: var(--space-3);
    }

    .model-thumb {
      flex: 0 0 120px;
      width: 120px;
    }

    .cell-params {
      margin-top: var(--space-3);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
    }

    .cell-params .param-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .cell-status {
      margin-top: var(--space-3);
      text-align: left;
    }

    .cell-details {
      margin-top: var(--space-3);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
      text-align: left;
    }
  }
</style>
