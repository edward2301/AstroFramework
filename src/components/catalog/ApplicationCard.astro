---
/**
 * 应用选型卡：应用名 + 工况摘要 + 推荐型号数。
 *
 * 纯数据驱动（无图片依赖），信息密度对齐 BOM 规格卡；
 * 悬停只加深边框；链接是唯一可点目标（44px 触控高度）。
 * 使用方：首页「按应用选型」。
 */
interface Props {
  href: string;
  /** 应用方向名（如「恒定工况运行」），作为 h3 与链接目标 */
  name: string;
  /** 工况/条件摘要，截断由调用方控制 */
  condition: string;
  /** 推荐型号数（mono 显示） */
  modelCount: number;
  /** 型号数单位文案（如「3 models」/「3 个型号」） */
  modelCountLabel: string;
  /** 详情链接文案 */
  linkLabel: string;
}

const { href, name, condition, modelCount, modelCountLabel, linkLabel } = Astro.props;
---

<div class="app-card">
  <div class="app-card-body">
    <h3 class="app-card-name"><a href={href}>{name}</a></h3>
    <p class="app-card-condition">{condition}</p>
    <div class="app-card-meta">
      <span class="app-card-count mono">{modelCountLabel}</span>
      <a class="app-card-link" href={href}>{linkLabel}</a>
    </div>
  </div>
</div>

<style>
  .app-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: border-color var(--duration-1) var(--ease);
  }

  .app-card:hover {
    border-color: var(--color-border-strong);
  }

  .app-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5);
  }

  .app-card-name {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-h3);
    letter-spacing: var(--ls-tight);
  }

  .app-card-name a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .app-card-name a:hover {
    color: var(--color-link);
  }

  /* 工况摘要：2 行截断，余下由详情页承接 */
  .app-card-condition {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 底部：型号数 + 详情链接，细线上方 */
  .app-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .app-card-count {
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  /* 详情链接是唯一触摸目标：移动端补到 44px 高 */
  .app-card-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-link);
    text-decoration: none;
  }

  .app-card-link:hover {
    color: var(--color-link-hover);
  }

  /* 移动端 44px 触控高度 */
  @media (max-width: 768px) {
    .app-card-link {
      min-height: 44px;
    }
  }
</style>
