---
/**
 * 产品总览主体（工业数据目录版）。只负责渲染，数据由路由层准备。
 *
 * 结构：PageHeader → 品类筛选 pill + 搜索（默认隐藏）→ aria-live 计数
 * → 全型号密集表（服务器渲染全部行）→ 空态 → CTA。
 *
 * JS 只做行过滤与计数（内联脚本，不进全站共享 JS）：
 * 无 JS 时所有行可见、pill 直接跳品类页、搜索表单保持隐藏。
 */
import PageHeader from '../layout/PageHeader.astro';
import CtaBand from '../layout/CtaBand.astro';
import CatalogTable from '../catalog/CatalogTable.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath, ROUTES } from '../../data/routes';
import { CATALOG_PAGE_SIZE } from '../../data/site';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  categories: {
    id: string;
    name: string;
    intro: string;
    modelCount: number;
    /** 品类封面 = 该品类首个型号的主图（public/ 下路径） */
    image?: string;
  }[];
  models: {
    id: string;
    categoryId: string;
    categoryName: string;
    code: string;
    name: string;
    status: 'active' | 'discontinued';
    keyParams: { k: string; v: string }[];
    image?: string;
  }[];
  totalModels: number;
}

const { locale, crumbs, categories, models, totalModels } = Astro.props;
const dict = t(locale);
---

<PageHeader
  locale={locale}
  crumbs={crumbs}
  title={dict.products.h1}
  lead={dict.products.lead(categories.length, totalModels)}
  width="wide"
/>

<section class="section" data-catalog data-page-size={CATALOG_PAGE_SIZE}>
  <div class="container">
    <div class="catalog-toolbar">
      <nav class="filter-nav" aria-label={dict.products.filterLabel}>
        <a
          class="filter-pill"
          href={localizePath(locale, ROUTES.products)}
          data-filter="all"
          aria-current="true">{dict.products.filterAll}</a>
        {
          categories.map((c) => (
            <a
              class="filter-pill"
              href={localizePath(locale, detailPath.category(c.id))}
              data-filter={c.id}
            >
              {c.name}
            </a>
          ))
        }
      </nav>

      {/* 搜索默认 hidden：只有内联脚本接管后才显示，无 JS 不留一个不能用的表单 */}
      <form class="catalog-search" role="search" data-catalog-search hidden>
        <label class="visually-hidden" for="catalog-search-input">{dict.products.searchLabel}</label>
        <input
          id="catalog-search-input"
          data-catalog-input
          type="search"
          name="q"
          placeholder={dict.products.searchPlaceholder}
          autocomplete="off"
        />
      </form>
    </div>

    <p
      class="catalog-count"
      aria-live="polite"
      aria-atomic="true"
      data-count
      data-unit-singular={dict.products.modelUnit}
      data-unit-plural={dict.products.modelUnitPlural}>{dict.products.resultCount(totalModels)}</p>

    <p class="table-hint">{dict.products.tableHint}</p>

    <CatalogTable
      locale={locale}
      models={models}
      scrollLabel={`${dict.products.h1} — ${dict.products.filterAll}`}
    />

    <div
      class="catalog-more"
      data-catalog-more
      data-status-more={dict.products.showingCount(0, 0)}
      data-status-done={dict.products.allShown(0)}
      hidden
    >
      <button type="button" class="btn btn--secondary" data-load-more aria-controls="catalog-table">
        {dict.products.loadMore}
      </button>
      <p
        class="catalog-more-status"
        data-more-status
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></p>
      <div class="catalog-sentinel" data-catalog-sentinel aria-hidden="true"></div>
    </div>

    <p class="catalog-empty" data-empty hidden>{dict.products.empty}</p>
  </div>
</section>

<script is:inline>
  (function () {
    var page = document.querySelector('[data-catalog]');
    if (!page) return;

    var rows = Array.prototype.slice.call(page.querySelectorAll('[data-model-row]'));
    var pills = Array.prototype.slice.call(page.querySelectorAll('[data-filter]'));
    var form = page.querySelector('[data-catalog-search]');
    var input = page.querySelector('[data-catalog-input]');
    var count = page.querySelector('[data-count]');
    var empty = page.querySelector('[data-empty]');
    var table = page.querySelector('[data-catalog-table]');
    if (rows.length === 0 || pills.length === 0 || !count || !empty || !table) return;

    // 脚本可用才显示搜索表单
    if (form) form.hidden = false;

    var unitOne = count.getAttribute('data-unit-singular') || '';
    var unitMany = count.getAttribute('data-unit-plural') || unitOne;
    var category = 'all';
    var query = '';
    /* 每页条数由 src/data/site.ts 的 CATALOG_PAGE_SIZE 配置 */
    var PAGE_SIZE = parseInt(page.getAttribute('data-page-size'), 10) || 10;
    var shown = PAGE_SIZE;
    var totalVisible = 0;

    var moreWrap = page.querySelector('[data-catalog-more]');
    var loadMoreBtn = page.querySelector('[data-load-more]');
    var moreStatus = page.querySelector('[data-more-status]');
    var sentinel = page.querySelector('[data-catalog-sentinel]');
    var statusMoreTemplate = moreWrap ? moreWrap.getAttribute('data-status-more') : '';
    var statusDoneTemplate = moreWrap ? moreWrap.getAttribute('data-status-done') : '';
    var observer = null;

    function setActive(id) {
      for (var i = 0; i < pills.length; i += 1) {
        if (pills[i].getAttribute('data-filter') === id) {
          pills[i].setAttribute('aria-current', 'true');
        } else {
          pills[i].removeAttribute('aria-current');
        }
      }
    }

    function apply(reset) {
      if (reset) {
        shown = PAGE_SIZE;
        if (moreStatus) moreStatus.textContent = '';
      }
      var visibleCount = 0;
      for (var i = 0; i < rows.length; i += 1) {
        var row = rows[i];
        var inCategory = category === 'all' || row.getAttribute('data-category') === category;
        var inQuery = query === '' || (row.getAttribute('data-search') || '').indexOf(query) !== -1;
        if (inCategory && inQuery) {
          row.hidden = visibleCount >= shown;
          visibleCount += 1;
        } else {
          row.hidden = true;
        }
      }
      totalVisible = visibleCount;
      if (shown > totalVisible) shown = totalVisible;
      count.textContent = totalVisible + ' ' + (totalVisible === 1 ? unitOne : unitMany);
      empty.hidden = totalVisible !== 0;
      table.hidden = totalVisible === 0;
      syncMore();
    }

    function formatStatus(template, visibleCount, total) {
      if (!template) return '';
      return template.replace(/\b0\b/, String(visibleCount)).replace(/\b0\b/, String(total));
    }

    function syncMore() {
      if (!moreWrap) return;
      var remaining = totalVisible - shown;
      if (totalVisible <= PAGE_SIZE) {
        moreWrap.hidden = true;
        if (observer) observer.disconnect();
        return;
      }
      moreWrap.hidden = false;
      if (remaining > 0) {
        if (loadMoreBtn) loadMoreBtn.hidden = false;
        if (moreStatus) moreStatus.textContent = formatStatus(statusMoreTemplate, shown, totalVisible);
        if (observer && sentinel) observer.observe(sentinel);
      } else {
        if (loadMoreBtn) loadMoreBtn.hidden = true;
        if (moreStatus) moreStatus.textContent = formatStatus(statusDoneTemplate, totalVisible, totalVisible);
        if (observer) observer.disconnect();
      }
    }

    function loadMore() {
      if (totalVisible - shown <= 0) return;
      var focusWasOnButton = document.activeElement === loadMoreBtn;
      shown = Math.min(shown + PAGE_SIZE, totalVisible);
      apply(false);
      if (focusWasOnButton && loadMoreBtn && loadMoreBtn.hidden && moreStatus) {
        moreStatus.tabIndex = -1;
        moreStatus.focus({ preventScroll: true });
      }
    }

    if ('IntersectionObserver' in window && sentinel) {
      try {
        observer = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i += 1) {
              if (entries[i].isIntersecting) {
                loadMore();
                break;
              }
            }
          },
          { rootMargin: '0px 0px 300px 0px', threshold: 0 }
        );
      } catch (error) {
        observer = null;
      }
    }

    function syncUrl() {
      if (!window.history || !window.history.replaceState) return;
      var url = new URL(window.location.href);
      if (category === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', category);
      }
      window.history.replaceState(null, '', url.toString());
    }

    for (var p = 0; p < pills.length; p += 1) {
      pills[p].addEventListener('click', function (event) {
        // 修饰键/中键仍按浏览器默认开新标签，交给品类页
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
          return;
        }
        var id = this.getAttribute('data-filter');
        if (!id) return;
        event.preventDefault();
        category = id;
        setActive(id);
        apply(true);
        syncUrl();
      });
    }

    if (input) {
      input.addEventListener('input', function () {
        query = this.value.trim().toLowerCase();
        apply(true);
      });
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', loadMore);
    }

    if (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
      });
    }

    // 首次载入只接受目录里存在的品类 id；未知值按「全部型号」处理
    var initial = new URLSearchParams(window.location.search).get('category');
    if (initial) {
      for (var k = 0; k < pills.length; k += 1) {
        if (pills[k].getAttribute('data-filter') === initial) {
          category = initial;
          setActive(initial);
          break;
        }
      }
    }

    apply(true);
  })();
</script>

<CtaBand locale={locale} />

<style>
  .catalog-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  /* pill 是真实链接：无缝拼成一条细线工具条，直角、无圆角 */
  .filter-nav {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    margin-left: -1px;
    border: 1px solid var(--color-border);
    font-size: var(--fs-sm);
    line-height: 1.2;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .filter-pill:first-child {
    margin-left: 0;
  }

  .filter-pill:hover {
    background: var(--color-subtle);
    color: var(--color-text);
    text-decoration: none;
  }

  .filter-pill[aria-current='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-on-dark);
  }

  .filter-pill[aria-current='true']:hover {
    background: var(--color-ink-soft);
    color: var(--color-on-dark);
  }

  .catalog-search {
    display: flex;
    align-items: center;
    flex: 0 1 320px;
    min-width: 220px;
  }

  /* 覆盖 display，否则 [hidden] 会被上面的 flex 顶掉 */
  .catalog-search[hidden] {
    display: none;
  }

  .catalog-search input {
    width: 100%;
    height: 40px;
    padding: 0 12px;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
  }

  .catalog-search input::placeholder {
    color: var(--color-muted);
  }

  .catalog-search input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }

  /* ≤768 触控高度 44px：筛选 pill 与搜索框（搜索框须后置于上面的 40px 基础规则才能覆盖） */
  @media (max-width: 768px) {
    .filter-pill {
      min-height: 44px;
      padding: 0 14px;
    }

    .catalog-search input {
      height: 44px;
    }
  }

  .catalog-count {
    margin: var(--space-3) 0 var(--space-4);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .catalog-empty {
    margin: var(--space-6) 0 0;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    text-align: center;
    color: var(--color-muted);
  }

  .catalog-empty[hidden] {
    display: none;
  }

  /* 表内横滚提示：仅 769–1024 的表格滚动形态出现；≤768 已卡片化（排版走全局 .table-hint） */
  .table-hint {
    display: none;
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .table-hint {
      display: block;
    }
  }

  /* 渐进加载：显式按钮 + 状态；IntersectionObserver 只作增强 */
  .catalog-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .catalog-more[hidden] {
    display: none;
  }

  .catalog-more [data-load-more][hidden] {
    display: none;
  }

  .catalog-more-status {
    min-height: 1.4em;
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--color-muted);
  }

  .catalog-sentinel {
    height: 1px;
  }
</style>
