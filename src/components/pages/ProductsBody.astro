---
/**
 * 产品总览主体（工业数据目录版）。只负责渲染，数据由路由层准备。
 *
 * 结构：品类索引表（可扫读的目录入口）→ 品类目录行（280px 图 + 文案）→ CTA。
 */
import PageHeader from '../layout/PageHeader.astro';
import CtaBand from '../layout/CtaBand.astro';
import CategoryRow from '../cards/CategoryRow.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  categories: {
    id: string;
    name: string;
    intro: string;
    modelCount: number;
    /** 品类封面 = 该品类首个型号的主图（public/ 下路径） */
    image?: string;
  }[];
  totalModels: number;
}

const { locale, crumbs, categories, totalModels } = Astro.props;
const dict = t(locale);
---

<PageHeader
  locale={locale}
  crumbs={crumbs}
  title={dict.products.h1}
  lead={dict.products.lead(categories.length, totalModels)}
/>

<section class="section">
  <div class="container">
    {/* 品类索引表：先给一张可扫读的目录，再进入逐个介绍 */}
    <table class="data-table index-table">
      <caption>{dict.products.h1}</caption>
      <thead>
        <tr>
          <th scope="col">{dict.footer.columns.products}</th>
          <th scope="col">{dict.category.modelsTitle}</th>
          <th scope="col">{dict.category.detailLink}</th>
        </tr>
      </thead>
      <tbody>
        {
          categories.map((c) => (
            <tr>
              <th scope="row">
                <a href={localizePath(locale, detailPath.category(c.id))}>{c.name}</a>
              </th>
              <td>{c.modelCount}</td>
              <td>
                <a href={localizePath(locale, detailPath.category(c.id))}>
                  {dict.products.browseModels(c.modelCount)}
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <div class="category-rows">
      {
        categories.map((c) => (
          <CategoryRow
            href={localizePath(locale, detailPath.category(c.id))}
            name={c.name}
            intro={`${c.intro.slice(0, 150)}…`}
            linkLabel={dict.products.browseModels(c.modelCount)}
            image={c.image}
          />
        ))
      }
    </div>
  </div>
</section>

<CtaBand locale={locale} />

<style>
  .index-table {
    margin-bottom: var(--space-8);
  }

  .index-table th[scope='row'] {
    width: auto;
    font-weight: 500;
  }

  .index-table td {
    width: 1%;
    white-space: nowrap;
  }

  /* 品类行之间用细线分隔：比纯留白更有目录节奏，也便于滚动时定位 */
  .category-rows {
    display: grid;
    gap: var(--space-7);
  }

  .category-rows > * + * {
    position: relative;
    padding-top: var(--space-7);
    /* 分隔线比正文边框更淡：只做节奏提示，不抢视线 */
    border-top: 1px solid var(--color-border-soft);
  }
</style>
