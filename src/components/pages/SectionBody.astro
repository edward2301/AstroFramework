---
/**
 * 栏目页主体（应用方向 / 案例 / 指南 / 问答 / 下载 / 认证与质量）。
 *
 * 与基准页（首页、产品中心）同一套骨架：section + container + PageHeader，
 * 标题层级 h1 → h2，内容区给「栏目定位 + 当前状态 + 替代入口」三段，
 * 集合为空时也不会出现空白页或死路（每条替代入口都是真实内链）。
 *
 * 集合有内容后，由各自的路由在此处追加列表渲染。
 */
import PageHeader from '../layout/PageHeader.astro';
import MetricStrip from '../layout/MetricStrip.astro';
import { localizePath, type Locale } from '../../i18n/routing';
import { ROUTES } from '../../data/routes';
import { t } from '../../i18n/ui';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  heading: string;
  body: { intro: string; current: string };
  /** 该栏目下的条目；为空时渲染空状态 */
  items: { title: string; meta?: string; href: string; badge?: string }[];
  /** 栏目指标（条目数、覆盖型号数等） */
  metrics: { value: string; label: string }[];
}

const { locale, crumbs, heading, body, items, metrics } = Astro.props;
const dict = t(locale);

/** 空状态下的替代入口：都是站内真实页面，避免栏目页成为死路 */
const related = [
  { href: localizePath(locale, ROUTES.products), label: dict.nav.products },
  { href: localizePath(locale, ROUTES.certifications), label: dict.section.quality },
  { href: localizePath(locale, ROUTES.quote), label: dict.nav.quote },
];
---

<PageHeader locale={locale} crumbs={crumbs} title={heading} lead={body.intro} />

<section class="section">
  <div class="container">
    {metrics.length > 0 && <MetricStrip items={metrics} />}

    {/* 栏目说明：有列表时同样要出现，否则页面只剩标题与卡片，正文全丢 */}
    {body.current.trim() !== '' && <p class="section-current">{body.current}</p>}

    <div class="section-layout">
      <div class="section-main">
        {
          items.length > 0 ? (
            <>
              <h2>{dict.section.items}</h2>
              <ul class="items">
                {items.map((it, i) => (
                  <li>
                    <a href={it.href}>
                      <span class="item-mark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      <strong>{it.title}</strong>
                      {it.meta && <span class="meta">{it.meta}</span>}
                      {it.badge && <span class="badge">{it.badge}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <>
              <h2>{dict.section.statusTitle}</h2>
              <p class="status">{body.current}</p>
            </>
          )
        }
      </div>

      <aside class="related">
        <h2>{dict.section.related}</h2>
        <ul class="links">
          {related.map((r) => (
            <li>
              <a href={r.href}>{r.label} →</a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  /* 指标条与下方正文的节奏（MetricStrip 为子组件，需 :global 触达） */
  :global(.metrics) {
    margin-bottom: var(--space-6);
  }

  /* 栏目说明段：与列表同宽、灰字，读起来像导语而不是正文墙 */
  .section-current {
    max-width: 760px;
    margin: 0 0 var(--space-6);
    color: var(--color-muted);
  }

  /* 主栏 + 320px 侧栏；≤1024 单列 */
  .section-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-7);
    align-items: start;
  }

  .status {
    max-width: 680px;
    margin: 0;
  }

  /* 条目列表：细线瓦片，列宽随容器自适应 */
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }

  .items a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color var(--duration-1) var(--ease);
  }

  /* hover 只换描边颜色：不抬升、不加影、不做蓝色底 */
  .items a:hover {
    border-color: var(--color-border-strong);
  }

  /* 序号：等宽小字 + 下方细线，纯装饰（aria-hidden） */
  .item-mark {
    align-self: flex-start;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    color: var(--color-muted);
  }

  .items strong {
    font-size: var(--fs-body);
    color: var(--color-ink);
    line-height: 1.4;
  }

  .items .meta {
    font-size: var(--fs-sm);
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .items .badge {
    margin-top: auto;
    align-self: flex-start;
  }

  /* 侧栏：上下细线分段，无底色、无圆角 */
  .related {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .related h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links li {
    border-top: 1px solid var(--color-border-soft);
  }

  .links a {
    display: block;
    padding: var(--space-3) 0;
    font-size: var(--fs-sm);
    color: var(--color-link);
  }

  .links a:hover {
    color: var(--color-link-hover);
  }

  @media (max-width: 1024px) {
    .section-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
