---
import type { RenderedContent } from '../../lib/content/guides';
/**
 * 技术指南详情主体。
 *
 * 结构化字段与正文都来自本语言的那一份文件（guides/*.md 或 guides/zh/*.md），
 * 不涉及跨语言回落：中文页取到的就是中文正文。页面层只负责排版。
 */
import PageHeader from '../layout/PageHeader.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  guide: { title: string; tldr: string; updated: string };
  /** astro:content render() 产出的正文组件 */
  Content: RenderedContent;
  models: { id: string; categoryId: string; code: string; name: string }[];
}

const { locale, crumbs, guide, Content, models } = Astro.props;
const dict = t(locale);
---

<PageHeader locale={locale} crumbs={crumbs} title={guide.title} width="narrow" />

<section class="section">
  <div class="container container-narrow">
    <p class="meta">{dict.detail.updated(guide.updated)}</p>
    <p class="intro">{guide.tldr}</p>

    <div class="prose">
      <Content />
    </div>

    {
      models.length > 0 && (
        <>
          <h2>{dict.detail.relatedModels}</h2>
          <ul class="model-links">
            {models.map((m) => (
              <li>
                <a href={localizePath(locale, detailPath.model(m.categoryId, m.id))}>
                  {m.code} — {m.name}
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }

  </div>
</section>

<style>
  .meta {
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }

  .intro {
    max-width: 760px;
  }

  .prose {
    max-width: 760px;
  }

  .model-links {
    max-width: 760px;
  }

  .model-links a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
