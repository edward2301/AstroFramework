---
import type { RenderedContent } from '../../lib/content/guides';
/**
 * 技术指南详情主体。
 *
 * 结构化字段与正文都来自本语言的那一份文件（guides/*.md 或 guides/zh/*.md），
 * 不涉及跨语言回落：中文页取到的就是中文正文。页面层只负责排版。
 */
import PageHeader from '../layout/PageHeader.astro';
import DetailLayout from '../layout/DetailLayout.astro';
import ModelLinkList from '../catalog/ModelLinkList.astro';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/routing';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  guide: { title: string; tldr: string; updated: string };
  /** astro:content render() 产出的正文组件 */
  Content: RenderedContent;
  models: { id: string; categoryId: string; code: string; name: string }[];
}

const { locale, crumbs, guide, Content, models } = Astro.props;
const dict = t(locale);
const hasAside = models.length > 0;
---

<PageHeader locale={locale} crumbs={crumbs} title={guide.title} width="narrow" />

<section class="section">
  <div class="container container-narrow">
    <DetailLayout aside={hasAside}>
      <div class="stack">
        <div class="lede">
          <p class="meta mono">{dict.detail.updated(guide.updated)}</p>
          <p class="intro">{guide.tldr}</p>
        </div>

        <div class="prose">
          <Content />
        </div>
      </div>

      {
        hasAside && (
          <div slot="aside">
            <p class="aside-title">{dict.detail.relatedModels}</p>
            <ModelLinkList locale={locale} models={models} />
          </div>
        )
      }
    </DetailLayout>
  </div>
</section>

<style>
  .stack {
    display: grid;
    gap: var(--space-8);
  }

  .lede {
    display: grid;
    gap: var(--space-3);
  }

  .meta {
    margin: 0;
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .intro {
    margin: 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  .aside-title {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
