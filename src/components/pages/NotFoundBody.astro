---
/**
 * 404 正文。
 *
 * 被默认语言的 404 页与各语言的 404 页共用，因此不写死任何文案与链接前缀，
 * 全部取自当前语言的字典与 localizePath。
 *
 * 页面外壳（页眉、页脚、html lang、元标签）由 BaseLayout 按 locale 渲染，
 * 新增语言时只要多一处调用，页眉页脚自动跟随，无需改这里。
 */
import { localizePath, type Locale } from '../../i18n/routing';
import { ROUTES } from '../../data/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="section">
  <div class="container">
    <p class="code">404</p>
    <h1>{dict.notFound.h1}</h1>
    <p class="lead">{dict.notFound.lead}</p>
    <p class="actions">
      <a class="btn btn--secondary" href={localizePath(locale, ROUTES.home)}>
        {dict.notFound.backHome}
      </a>
      <a class="btn btn--primary" href={localizePath(locale, ROUTES.products)}>
        {dict.notFound.browseProducts}
      </a>
      <a class="btn btn--secondary" href={localizePath(locale, ROUTES.quote)}>
        {dict.notFound.requestQuote}
      </a>
    </p>
  </div>
</section>

<style>
  /* 404 无 PageHeader，全局 `.page-header + .section` 收紧规则罩不到这里：
     覆写 .section 的上边距，否则页头与 404 数字之间是 80–112px 空带 */
  .section {
    padding-top: var(--space-5);
  }

  /* 404：等宽大号数字作视觉锚点，标题与正文回到可读层级 */
  .code {
    margin: 0 0 var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-h1);
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  h1 {
    max-width: 24ch;
    margin: 0 0 var(--space-4);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
  }

  .lead {
    max-width: var(--measure-lead);
    margin: 0;
    font-size: var(--fs-lead);
    color: var(--color-muted);
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin: var(--space-6) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
</style>
