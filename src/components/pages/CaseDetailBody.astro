---
/**
 * 案例详情主体。
 *
 * 正文数据来自案例条目（经 caseView 按语言回落），
 * 配置型号链接指向型号详情页。本组件不含取数与 SEO 装配。
 */
import PageHeader from '../layout/PageHeader.astro';
import DetailLayout from '../layout/DetailLayout.astro';
import SectionTitle from '../layout/SectionTitle.astro';
import ModelLinkList from '../catalog/ModelLinkList.astro';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/routing';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  caseStudy: {
    title: string;
    background: string;
    requirements: string[];
    selection: string;
    results: string[];
    date: string;
  };
  models: { id: string; categoryId: string; code: string; name: string }[];
}

const { locale, crumbs, caseStudy, models } = Astro.props;
const dict = t(locale);
---

<PageHeader locale={locale} crumbs={crumbs} title={caseStudy.title} width="narrow" />

<section class="section">
  <div class="container container-narrow">
    <DetailLayout>
      <div class="stack">
        <div class="lede">
          <p class="detail-meta mono">{dict.detail.date(caseStudy.date)}</p>
          <p class="intro">{caseStudy.background}</p>
        </div>

        <div>
          <SectionTitle title={dict.detail.requirements} />
          <ul class="points">
            {caseStudy.requirements.map((r) => <li>{r}</li>)}
          </ul>
        </div>

        <div>
          <SectionTitle title={dict.detail.selection} />
          <p class="body-text">{caseStudy.selection}</p>
        </div>

        {
          caseStudy.results.length > 0 && (
            <div>
              <SectionTitle title={dict.detail.results} />
              <ul class="points">
                {caseStudy.results.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <div slot="aside">
        <p class="aside-title">{dict.detail.configuredModels}</p>
        <ModelLinkList locale={locale} models={models} />
      </div>
    </DetailLayout>
  </div>
</section>

<style>
  /* 独有样式：正文段落（其余 .stack/.lede/.detail-meta/.intro/.points/.aside-title 走全局工具类） */
  .body-text {
    margin: 0;
    max-width: var(--measure);
    line-height: var(--lh-body);
  }
</style>
