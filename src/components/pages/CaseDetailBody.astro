---
/**
 * 案例详情主体。
 *
 * 正文数据来自案例条目（经 caseView 按语言回落），
 * 配置型号链接指向型号详情页。本组件不含取数与 SEO 装配。
 */
import PageHeader from '../layout/PageHeader.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  caseStudy: {
    title: string;
    background: string;
    requirements: string[];
    selection: string;
    results: string[];
    date: string;
  };
  models: { id: string; categoryId: string; code: string; name: string }[];
}

const { locale, crumbs, caseStudy, models } = Astro.props;
const dict = t(locale);
---

<section class="section">
  <div class="container narrow">
    <PageHeader locale={locale} crumbs={crumbs} title={caseStudy.title} />
    <p class="meta">{dict.detail.date(caseStudy.date)}</p>
    <p class="intro">{caseStudy.background}</p>

    <h2>{dict.detail.requirements}</h2>
    <ul class="points">
      {caseStudy.requirements.map((r) => <li>{r}</li>)}
    </ul>

    <h2>{dict.detail.selection}</h2>
    <p class="intro">{caseStudy.selection}</p>

    <h2>{dict.detail.configuredModels}</h2>
    <ul class="model-links">
      {
        models.map((m) => (
          <li>
            <a href={localizePath(locale, detailPath.model(m.categoryId, m.id))}>
              {m.code} — {m.name}
            </a>
          </li>
        ))
      }
    </ul>

    {
      caseStudy.results.length > 0 && (
        <>
          <h2>{dict.detail.results}</h2>
          <ul class="points">
            {caseStudy.results.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </>
      )
    }

  </div>
</section>

<style>
  .meta {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .intro {
    max-width: 760px;
  }

  .points {
    max-width: 760px;
  }

  .model-links {
    max-width: 760px;
  }

  .model-links a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
