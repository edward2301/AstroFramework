---
/**
 * 案例详情主体。
 *
 * 正文数据来自案例条目（经 caseView 按语言回落），
 * 配置型号链接指向型号详情页。本组件不含取数与 SEO 装配。
 */
import PageHeader from '../layout/PageHeader.astro';
import DetailLayout from '../layout/DetailLayout.astro';
import SectionTitle from '../layout/SectionTitle.astro';
import ModelLinkList from '../catalog/ModelLinkList.astro';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/routing';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  caseStudy: {
    title: string;
    background: string;
    requirements: string[];
    selection: string;
    results: string[];
    date: string;
  };
  models: { id: string; categoryId: string; code: string; name: string }[];
}

const { locale, crumbs, caseStudy, models } = Astro.props;
const dict = t(locale);
---

<PageHeader locale={locale} crumbs={crumbs} title={caseStudy.title} width="narrow" />

<section class="section">
  <div class="container container-narrow">
    <DetailLayout>
      <div class="stack">
        <div class="lede">
          <p class="meta mono">{dict.detail.date(caseStudy.date)}</p>
          <p class="intro">{caseStudy.background}</p>
        </div>

        <div>
          <SectionTitle title={dict.detail.requirements} />
          <ul class="points">
            {caseStudy.requirements.map((r) => <li>{r}</li>)}
          </ul>
        </div>

        <div>
          <SectionTitle title={dict.detail.selection} />
          <p class="body-text">{caseStudy.selection}</p>
        </div>

        {
          caseStudy.results.length > 0 && (
            <div>
              <SectionTitle title={dict.detail.results} />
              <ul class="points">
                {caseStudy.results.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <div slot="aside">
        <p class="aside-title">{dict.detail.configuredModels}</p>
        <ModelLinkList locale={locale} models={models} />
      </div>
    </DetailLayout>
  </div>
</section>

<style>
  .stack {
    display: grid;
    gap: var(--space-8);
  }

  .lede {
    display: grid;
    gap: var(--space-3);
  }

  .meta {
    margin: 0;
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .intro {
    margin: 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  .body-text {
    margin: 0;
    max-width: var(--measure);
    line-height: var(--lh-body);
  }

  /* 客户需求 / 运行效果：mono 序号 + 细线行，无彩色底 */
  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: point;
  }

  .points li {
    counter-increment: point;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  .points li::before {
    content: counter(point, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--ls-wide);
    color: var(--color-muted);
  }

  .points li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .aside-title {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
