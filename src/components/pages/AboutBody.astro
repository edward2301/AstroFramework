---
/**
 * 关于我们：条带页头（含指标 meta 行）→ 三组图文行（生产 / 文档 / 响应）→ 联系区。
 *
 * 采用「数字 + 图 + 短句」的节奏，图文交替形成 Z 字阅读动线；
 * 数字取自内容集合，不编造。
 */
import PageHeader from '../layout/PageHeader.astro';
import FeatureRow from '../layout/FeatureRow.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { ROUTES } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';
import { organizationFor } from '../../data/organization';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  heading: string;
  /** 指标 meta 行（品类 / 型号 / 响应），由静态装配层组好 */
  metaLine: string;
}

const { locale, crumbs, heading, metaLine } = Astro.props;
const dict = t(locale);
const org = organizationFor(locale);

const images = [
  { src: '/images/pages/about-production.png', alt: dict.aboutPage.sections[0]?.t ?? '' },
  { src: '/images/pages/about-documents.png', alt: dict.aboutPage.sections[1]?.t ?? '' },
  { src: '/images/pages/about-inspection.png', alt: dict.aboutPage.sections[2]?.t ?? '' },
];
---

<PageHeader
  locale={locale}
  crumbs={crumbs}
  title={heading}
  lead={org.description}
  meta={metaLine}
/>

<section class="section">
  <div class="container">
    <div class="about-rows">
      {
        dict.aboutPage.sections.slice(0, -1).map((sec, i) => (
          <FeatureRow
            title={sec.t}
            body={sec.d}
            image={images[i % images.length].src}
            imageAlt={images[i % images.length].alt}
            reverse={i % 2 === 1}
          />
        ))
      }
    </div>

    <div class="about-contact">
      <div class="about-contact-text">
        <h2>{dict.aboutPage.contactTitle}</h2>
        <p>{dict.quote.lead}</p>
        <a class="btn btn--primary" href={localizePath(locale, ROUTES.quote)}>{dict.home.requestQuote} →</a>
      </div>

      <dl class="about-contact-facts">
        <div>
          <dt>{dict.quote.emailLabel}</dt>
          <dd><a href={`mailto:${org.contactPoint.email}`}>{org.contactPoint.email}</a></dd>
        </div>
        <div>
          <dt>{dict.quote.telLabel}</dt>
          <dd><a href={`tel:${org.contactPoint.telephone}`}>{org.contactPoint.telephone}</a></dd>
        </div>
        <div>
          <dt>{dict.quote.addressLabel}</dt>
          <dd>
            {org.address.street}{locale === 'zh' ? ' ' : ', '}{org.address.city}{locale === 'zh' ? ' ' : ', '} {org.address.region} {org.address.postalCode}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  /* 联系区：正文在左、事实网格在右，顶部一条细线分带 */
  .about-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-7);
    align-items: start;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .about-contact-text p {
    color: var(--color-muted);
  }

  /* 事实网格：行间细线，无底色、无圆角 */
  .about-contact-facts {
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .about-contact-facts > div {
    display: grid;
    gap: 2px;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .about-contact-facts dt {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    color: var(--color-muted);
  }

  .about-contact-facts dd {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-sm);
    line-height: var(--lh-data);
    color: var(--color-ink);
  }

  .about-contact-facts dd a {
    color: var(--color-link);
  }

  @media (max-width: 1024px) {
    .about-contact {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  /* 联系方式是可点击的整行入口，移动端补到 44px 触控高度 */
  @media (max-width: 768px) {
    .about-contact-facts dd a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
