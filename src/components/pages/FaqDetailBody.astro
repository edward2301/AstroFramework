---
import type { RenderedContent } from '../../lib/content/guides';
/**
 * 问答详情主体。
 *
 * 问题与答案都来自本语言的那一份文件（faqs/*.md 或 faqs/zh/*.md），
 * 不涉及跨语言回落：中文页取到的就是中文问题与中文答案。
 */
import PageHeader from '../layout/PageHeader.astro';
import DetailLayout from '../layout/DetailLayout.astro';
import ModelLinkList from '../catalog/ModelLinkList.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  question: string;
  /** astro:content render() 产出的正文组件 */
  Content: RenderedContent;
  models: { id: string; categoryId: string; code: string; name: string }[];
  related: { id: string; question: string }[];
}

const { locale, crumbs, question, Content, models, related } = Astro.props;
const dict = t(locale);
const hasAside = models.length > 0 || related.length > 0;
---

<PageHeader locale={locale} crumbs={crumbs} title={question} width="narrow" />

<section class="section">
  <div class="container container-narrow">
    <DetailLayout aside={hasAside}>
      <div class="prose">
        <Content />
      </div>

      {
        models.length > 0 && (
          <div slot="aside">
            <p class="aside-title">{dict.detail.relatedModels}</p>
            <ModelLinkList locale={locale} models={models} />
          </div>
        )
      }

      {
        related.length > 0 && (
          <div slot="aside">
            <p class="aside-title">{dict.detail.relatedFaqs}</p>
            <ul class="aside-links">
              {related.map((f) => (
                <li>
                  <a href={localizePath(locale, detailPath.faq(f.id))}>{f.question}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </DetailLayout>
  </div>
</section>

<style>
  /* 独有样式：相关问题列表（.aside-title 走全局工具类） */
  .aside-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .aside-links li {
    border-top: 1px solid var(--color-border);
  }

  .aside-links li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .aside-links a {
    display: block;
    padding: var(--space-3) 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
  }
</style>
