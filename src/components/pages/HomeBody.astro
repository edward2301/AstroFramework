---
/**
 * 首页主体（工业数据目录版）。
 *
 * 只负责渲染，不取数、不拼 SEO —— 数据与元标签由路由层准备后传入。
 * 中英文路由共用本组件，差异只来自 locale 与已本地化的数据。
 *
 * 结构：石墨 hero（左文案 + 右可核验事实面板）→ 品类网格 → 精选型号网格 → CTA。
 * 轮播已移除：网格让所有卡片进入服务端 HTML 的同一屏流，不再有半空页。
 */
import CtaBand from '../layout/CtaBand.astro';
import SectionTitle from '../layout/SectionTitle.astro';
import CategoryCard from '../cards/CategoryCard.astro';
import ModelCard from '../cards/ModelCard.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { ROUTES, detailPath } from '../../data/routes';

interface Props {
  locale: Locale;
  categories: { id: string; name: string; intro: string; image?: string }[];
  models: {
    id: string;
    categoryId: string;
    code: string;
    name: string;
    firstParamKey: string;
    firstParam: string;
    /** 主图公开路径（public/ 下），来自内容条目的 image 字段 */
    image?: string;
  }[];
  /** 目录内型号总数：导语用它，与首页展示的卡片数（models）是两个数 */
  totalModels: number;
}

const { locale, categories, models, totalModels } = Astro.props;
const dict = t(locale);
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1>{dict.home.h1}</h1>
      <p class="lead">{dict.home.lead(categories.length, totalModels)}</p>
      <div class="actions">
        <a class="btn btn--primary btn--lg" href={localizePath(locale, ROUTES.products)}>
          {dict.home.browseProducts}
        </a>
        <a class="btn btn--on-dark btn--lg" href={localizePath(locale, ROUTES.quote)}>
          {dict.home.requestQuote}
        </a>
      </div>
    </div>

    {/* 可核验事实面板：措辞取自 /certifications/，不另造说法 */}
    <aside class="proof" aria-label={dict.home.trust.link}>
      <ul>
        {dict.home.trust.facts.map((fact) => <li>{fact}</li>)}
      </ul>
      <a class="proof-link" href={localizePath(locale, ROUTES.certifications)}>
        {dict.home.trust.link} →
      </a>
    </aside>
  </div>
</section>

<section class="section">
  <div class="container">
    <SectionTitle
      title={dict.home.categories}
      href={localizePath(locale, ROUTES.products)}
      linkLabel={dict.home.browseProducts}
    />
    <ul class="card-grid">
      {
        categories.map((c) => (
          <li>
            <CategoryCard
              href={localizePath(locale, detailPath.category(c.id))}
              name={c.name}
              intro={`${c.intro.slice(0, 80)}…`}
              linkLabel={`${dict.home.viewModels} →`}
              image={c.image}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

{
  models.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <SectionTitle title={dict.home.selectedModels} />
        <ul class="card-grid">
          {models.map((m) => (
            <li>
              <ModelCard
                href={localizePath(locale, detailPath.model(m.categoryId, m.id))}
                code={m.code}
                firstParamLabel={m.firstParamKey}
                firstParam={m.firstParam}
                image={m.image}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{/* 首页唯一的转化横条：hero 之后直到页脚的询价入口 */}
<CtaBand locale={locale} />

<style>
  /*
   * 石墨 hero：透明页眉浮在上面（白字），所以这里必须是深色底、白字。
   * 顶部内边距先补回固定页眉的高度（--header-h），再留出呼吸空间。
   */
  .hero {
    padding: calc(var(--header-h) + var(--space-8)) 0 var(--space-8);
    background: linear-gradient(160deg, var(--color-ink) 0%, var(--color-ink-soft) 100%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  .hero h1 {
    max-width: 820px;
    color: var(--color-on-dark);
  }

  .lead {
    max-width: 680px;
    font-size: var(--fs-lead);
    color: var(--color-on-dark-muted);
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }

  /* 可核验事实面板：深色带上的浅描边面板 */
  .proof {
    padding: var(--space-6);
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 6%);
  }

  .proof ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .proof li {
    position: relative;
    padding-left: 20px;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--color-on-dark-muted);
  }

  .proof li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-xs);
    background: rgb(255 255 255 / 45%);
  }

  .proof-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid rgb(255 255 255 / 14%);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-on-dark-active);
  }

  .proof-link:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* 宽屏两栏：左文案、右事实面板；面板比文案列窄，视线先落在 h1 上 */
  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
    }
  }

  .section-alt {
    background: var(--color-subtle);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* 卡片网格：1 / 2 / 3 栏；li 用 flex 让卡片等高 */
  .card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .card-grid > li {
    display: flex;
  }

  @media (min-width: 768px) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
