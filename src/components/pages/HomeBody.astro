---
/**
 * 首页主体（工业数据目录版）。
 *
 * 只负责渲染，不取数、不拼 SEO —— 数据与元标签由路由层准备后传入。
 * 中英文路由共用本组件，差异只来自 locale 与已本地化的数据。
 *
 * 结构：纯石墨 hero（8/4 栏，左文案 + 右编号事实）→ 品类网格 → 按应用选型色带 → CTA。
 */
import CtaBand from '../layout/CtaBand.astro';
import SectionTitle from '../layout/SectionTitle.astro';
import CategoryCard from '../cards/CategoryCard.astro';
import ApplicationCard from '../catalog/ApplicationCard.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { ROUTES, detailPath } from '../../data/routes';

interface Props {
  locale: Locale;
  categories: { id: string; name: string; intro: string; image?: string }[];
  applications: {
    id: string;
    name: string;
    condition: string;
    modelCount: number;
  }[];
  /** 目录内型号总数：导语用它 */
  totalModels: number;
}

const { locale, categories, applications, totalModels } = Astro.props;
const dict = t(locale);
/** 中文标题在逗号后固定断行，避免 16ch 上限在「参数」等词中间折断 */
const zhH1 = locale === 'zh' ? dict.home.h1.split('，') : null;
---

<section class:list={['hero', locale === 'en' && 'hero--en', locale === 'zh' && 'hero--zh']}>
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1>
        {
          zhH1 ? (
            <>
              {zhH1[0]}，<br /><span class="zh-h1-tail">{zhH1.slice(1).join('，')}</span>
            </>
          ) : (
            dict.home.h1
          )
        }
      </h1>
      <p class="lead">{dict.home.lead(categories.length, totalModels)}</p>
      <div class="actions">
        <a class="btn btn--primary btn--lg" href={localizePath(locale, ROUTES.products)}>
          {dict.home.browseProducts}
        </a>
      </div>
    </div>

    {/* 可核验事实：编号 + 细线分隔，无面板底色；措辞取自 /certifications/ */}
    <aside class="proof" aria-label={dict.home.trust.link}>
      <ol>
        {dict.home.trust.facts.map((fact) => <li>{fact}</li>)}
      </ol>
      <a class="proof-link" href={localizePath(locale, ROUTES.certifications)}>
        {dict.home.trust.link} →
      </a>
    </aside>
  </div>
</section>

<section class="section">
  <div class="container">
    <SectionTitle
      title={dict.home.categories}
      href={localizePath(locale, ROUTES.products)}
      linkLabel={dict.home.browseProducts}
    />
    <ul class="grid-list card-grid card-grid--categories">
      {
        categories.map((c) => (
          <li>
            <CategoryCard
              href={localizePath(locale, detailPath.category(c.id))}
              name={c.name}
              intro={c.intro.length > 80 ? `${c.intro.slice(0, 80)}…` : c.intro}
              linkLabel={`${dict.home.viewModels} →`}
              image={c.image}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

{
  applications.length > 0 && (
    <section class="section band">
      <div class="container">
        <SectionTitle title={dict.home.selectedModels} />
        <ul class="grid-list app-grid">
          {applications.map((a) => (
            <li>
              <ApplicationCard
                href={localizePath(locale, detailPath.application(a.id))}
                name={a.name}
                condition={a.condition}
                modelCountLabel={dict.products.modelsUnit(a.modelCount)}
                linkLabel={dict.category.detailLink}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{/* 首页唯一的转化横条：hero 之后直到页脚的询价入口 */}
<CtaBand locale={locale} />

<style>
  /*
   * 纯石墨 hero：透明页眉浮在上面（白字），所以这里必须是深色底、白字。
   * 顶部内边距先补回固定页眉的高度（--header-h），再留出呼吸空间。
   */
  .hero {
    padding: calc(var(--header-h) + var(--space-8)) 0 var(--space-9);
    background: var(--color-ink);
  }

  /*
   * 中文 hero 顶部：320–480 为 120px，481–512 平滑回到 124px，
   * 之后保持 124px；避免 480/481 的 4px 跳变。
   */
  .hero--zh {
    padding-top: calc(
      var(--header-h) + clamp(calc(var(--space-7) + var(--space-3)), 12.5vw, var(--space-8))
    );
  }

  .hero-inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    align-items: start;
  }

  .hero-copy {
    grid-column: 1 / -1;
  }

  .hero h1 {
    max-width: 16ch;
    color: var(--color-on-dark);
  }

  /* 逗号后的整句保持一行，避免 320px 只剩一个「项」的孤字 */
  .zh-h1-tail {
    white-space: nowrap;
  }

  .lead {
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    color: var(--color-on-dark-muted);
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }

  /* 编号事实列表：只有 1px 细线，无底色、无描边面板 */
  .proof {
    grid-column: 1 / -1;
  }

  .proof ol {
    counter-reset: proof;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .proof li {
    counter-increment: proof;
    display: grid;
    grid-template-columns: 3ch minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid rgb(255 255 255 / 14%);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--color-on-dark-muted);
  }

  .proof li::before {
    content: counter(proof, decimal-leading-zero);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    color: var(--color-on-dark-muted);
  }

  .proof li:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 14%);
  }

  .proof-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-4);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-on-dark-active);
  }

  .proof-link:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* 宽屏 8/4：左文案、右事实，h1 先落眼 */
  @media (min-width: 1024px) {
    .hero-copy {
      grid-column: span 8;
    }

    .proof {
      grid-column: span 4;
    }
  }

  /*
   * 英文标题更长：320–360px 下标题 32–36px、顶部留白 112px，
   * 到 480px 平滑回到 36px / 124px；中文 hero 不受影响。
   */
  @media (max-width: 480px) {
    .hero--en {
      padding-top: calc(var(--header-h) + clamp(52px, 14.44vw, var(--space-8)));
    }

    .hero--en h1 {
      font-size: clamp(2rem, 10vw, 2.25rem);
    }

    /* 568px 首屏：导语降一档、按钮间距收紧，主 CTA 可完整落在首屏内 */
    .hero--en .lead {
      font-size: var(--fs-body);
    }

    .hero--en .actions {
      gap: var(--space-2);
    }
  }

  /* 色带走全局 .band；这里只保留卡片网格节奏 */
  .card-grid {
    gap: var(--space-5);
  }

  .card-grid--categories {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  /* 按应用选型：3 列桌面、2 列平板、1 列手机 */
  .app-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-5);
  }

  .app-grid > li {
    display: flex;
  }

  /* li 用 flex 让卡片在同行拉齐 */
  .card-grid > li {
    display: flex;
  }
</style>
