---
/**
 * 品类页主体（工业数据目录版）。
 *
 * 结构：PageHeader（meta 数据行 + 询价按钮）→ 型号视觉网格
 * → 参数对比表（参数唯一出处）→ 采购信息 4-up → 品类说明（8/4）→ CTA。
 *
 * 参数只在对比表出现一次，瓦片退为「图 + 编码 + 状态」的入口；
 * purchaseInfo 来自品类条目（经 categoryView 本地化），这里只排版。
 */
import PageHeader from '../layout/PageHeader.astro';
import SectionTitle from '../layout/SectionTitle.astro';
import CtaBand from '../layout/CtaBand.astro';
import ComparisonTable from '../catalog/ComparisonTable.astro';
import PurchaseFacts from '../catalog/PurchaseFacts.astro';
import ModelTile from '../cards/ModelTile.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath, ROUTES } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  categoryId: string;
  category: {
    name: string;
    intro: string;
    image?: string;
    comparisonParams: string[];
    selectionPoints: string[];
    purchaseInfo: {
      moq: string;
      leadTime: string;
      payment: string;
      certifications: string[];
    };
  };
  models: {
    id: string;
    code: string;
    name: string;
    status: 'active' | 'discontinued';
    cells: string[];
    image?: string;
  }[];
  discontinuedCount: number;
}

const { locale, crumbs, categoryId, category, models, discontinuedCount } = Astro.props;
const dict = t(locale);

/** 页头数据行：型号数 · 参数数（· 停产提示），tabular 数字 */
const metaLine = [
  dict.products.modelsUnit(models.length),
  dict.category.paramsUnit(category.comparisonParams.length),
  discontinuedCount > 0 ? dict.category.discontinuedNote(discontinuedCount) : '',
]
  .filter(Boolean)
  .join(' · ');
---

<PageHeader locale={locale} crumbs={crumbs} title={category.name} meta={metaLine}>
  <a class="btn btn--primary" slot="actions" href={localizePath(locale, ROUTES.quote)}>
    {dict.home.requestQuote}
  </a>
</PageHeader>

<section class="section">
  <div class="container">
    <SectionTitle title={dict.category.modelsTitle} />

    {/* 型号视觉网格：图上文下，参数留给对比表 */}
    <ul class="tile-grid">
      {
        models.map((m) => (
          <li>
            <ModelTile
              href={localizePath(locale, detailPath.model(m.id))}
              code={m.code}
              name={m.name}
              status={m.status}
              discontinuedLabel={dict.category.discontinued}
              params={[]}
              image={m.image}
              linkLabel={dict.category.detailLink}
              colon={locale === 'zh' ? '：' : ': '}
              compact
            />
          </li>
        ))
      }
    </ul>

    {/* 参数对比表：全页参数唯一出处 */}
    <div class="compare-block">
      <p class="table-hint">{dict.products.tableHint}</p>
      <ComparisonTable
        locale={locale}
        categoryId={categoryId}
        categoryName={category.name}
        comparisonParams={category.comparisonParams}
        models={models}
        scrollLabel={`${category.name} — ${dict.category.modelsTitle}`}
      />
    </div>

    <div class="purchase-block">
      <PurchaseFacts
        purchaseInfo={category.purchaseInfo}
        labels={{
          moq: dict.category.moq,
          leadTime: dict.category.leadTime,
          payment: dict.category.payment,
          certifications: dict.model.certifications,
        }}
      />
    </div>
  </div>
</section>

<section class="section about-section">
  <div class="container">
    <SectionTitle title={dict.category.about} />

    <div class="grid-12 about-grid">
      <p class="about-intro">{category.intro}</p>

      {
        category.selectionPoints.length > 0 && (
          <div class="about-side">
            <p class="about-kicker">{dict.category.howToSelect}</p>
            <ol class="about-points">
              {category.selectionPoints.map((p) => (
                <li>{p}</li>
              ))}
            </ol>
          </div>
        )
      }
    </div>
  </div>
</section>

<CtaBand locale={locale} />

<style>
  /* 瓦片网格：240px 起，auto-fill 保持目录列宽一致 */
  .tile-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: var(--space-4);
  }

  .tile-grid > li {
    display: flex;
  }

  /* 769–1024 也固定 2 列：避免 768 以下 2 列、769 起回落到 1 列的断点跳变 */
  @media (max-width: 1024px) {
    .tile-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 手机端再收紧间距；桌面列宽不变 */
  @media (max-width: 768px) {
    .tile-grid {
      gap: var(--space-3);
    }
  }

  /* 对比表：细线分隔的数据板，不自带标题（caption 即区块标签） */
  .compare-block {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  /* 表内横滚提示：只在会溢出的宽度出现 */
  .table-hint {
    display: none;
  }

  @media (max-width: 1024px) {
    .table-hint {
      display: block;
      margin: 0 0 var(--space-2);
      font-size: var(--fs-xs);
      color: var(--color-muted);
    }
  }

  .purchase-block {
    margin-top: var(--space-7);
  }

  .about-section {
    border-top: 1px solid var(--color-border);
  }

  .about-grid {
    margin-top: 0;
  }

  .about-intro {
    grid-column: span 8 / span 8;
    margin: 0;
    max-width: var(--measure-lead);
    color: var(--color-muted);
  }

  .about-side {
    grid-column: span 4 / span 4;
  }

  .about-kicker {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* 选型要点：编号 mono + 细线分隔 */
  .about-points {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: point;
  }

  .about-points li {
    counter-increment: point;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  .about-points li::before {
    content: counter(point, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--ls-wide);
    color: var(--color-muted);
  }

  .about-points li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 1024px) {
    .about-intro,
    .about-side {
      grid-column: span 12 / span 12;
    }
  }
</style>
