---
/**
 * 品类页主体（工业数据目录版）。
 *
 * 结构：PageHeader（meta 数据行 + 询价按钮）→ 对比表（参数唯一出处）
 * → 采购信息 4-up → 型号速览（次级紧凑卡）→ 品类说明 → CTA。
 *
 * 参数只在对比表出现一次，卡片退为「图 + 编码 + 状态」的次级入口；
 * purchaseInfo 来自品类条目（经 categoryView 本地化），这里只排版。
 */
import PageHeader from '../layout/PageHeader.astro';
import SectionTitle from '../layout/SectionTitle.astro';
import CtaBand from '../layout/CtaBand.astro';
import ComparisonTable from '../catalog/ComparisonTable.astro';
import PurchaseFacts from '../catalog/PurchaseFacts.astro';
import ModelTile from '../cards/ModelTile.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath, ROUTES } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  categoryId: string;
  category: {
    name: string;
    intro: string;
    image?: string;
    comparisonParams: string[];
    selectionPoints: string[];
    purchaseInfo: {
      moq: string;
      leadTime: string;
      payment: string;
      certifications: string[];
    };
  };
  models: {
    id: string;
    code: string;
    status: 'active' | 'discontinued';
    cells: string[];
    image?: string;
  }[];
  discontinuedCount: number;
}

const { locale, crumbs, categoryId, category, models, discontinuedCount } = Astro.props;
const dict = t(locale);

/** 页头数据行：型号数 · 参数数（· 停产提示），tabular 数字 */
const metaLine = [
  dict.products.modelsUnit(models.length),
  dict.category.paramsUnit(category.comparisonParams.length),
  discontinuedCount > 0 ? dict.category.discontinuedNote(discontinuedCount) : '',
]
  .filter(Boolean)
  .join(' · ');
---

<PageHeader locale={locale} crumbs={crumbs} title={category.name} meta={metaLine}>
  <a class="btn btn--primary" slot="actions" href={localizePath(locale, ROUTES.quote)}>
    {dict.home.requestQuote}
  </a>
</PageHeader>

<section class="section">
  <div class="container">
    <SectionTitle title={dict.category.modelsTitle} />

    <ComparisonTable
      locale={locale}
      categoryId={categoryId}
      categoryName={category.name}
      comparisonParams={category.comparisonParams}
      models={models}
      scrollLabel={`${category.name} — ${dict.category.modelsTitle}`}
    />

    <PurchaseFacts
      purchaseInfo={category.purchaseInfo}
      labels={{
        moq: dict.category.moq,
        leadTime: dict.category.leadTime,
        payment: dict.category.payment,
        certifications: dict.model.certifications,
      }}
    />

    {/* 型号速览：次级入口，参数以对比表为准，不再重复 */}
    <ul class="tile-grid">
      {
        models.map((m) => (
          <li>
            <ModelTile
              href={localizePath(locale, detailPath.model(categoryId, m.id))}
              code={m.code}
              status={m.status}
              discontinuedLabel={dict.category.discontinued}
              params={[]}
              image={m.image}
              linkLabel={dict.category.detailLink}
              colon={locale === 'zh' ? '：' : ': '}
              compact
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section about-section">
  <div class="container">
    <SectionTitle title={dict.category.about} />

    <div class="grid-12 about-grid">
      <p class="span-8">{category.intro}</p>

      {
        category.selectionPoints.length > 0 && (
          <ul class="span-4 about-points">
            {category.selectionPoints.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<CtaBand locale={locale} />

<style>
  .tile-grid {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  .tile-grid > li {
    display: flex;
  }

  @media (min-width: 768px) {
    .tile-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .tile-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .about-section {
    border-top: 1px solid var(--color-border);
  }

  .about-grid {
    margin-top: 0;
  }

  .about-grid > p {
    margin: 0;
    color: var(--color-muted);
    grid-column: span 8 / span 8;
  }

  .about-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    grid-column: span 4 / span 4;
    align-content: start;
  }

  .about-points li {
    position: relative;
    padding-left: 14px;
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }

  /* 铜色小方点：选型要点是数据类内容，用 data 色标记 */
  .about-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-xs);
    background: var(--color-data);
  }

  @media (max-width: 1024px) {
    .about-grid > p {
      grid-column: span 12 / span 12;
    }

    .about-points {
      grid-column: span 12 / span 12;
    }
  }
</style>
