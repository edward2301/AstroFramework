---
/**
 * 品类页主体：紧凑横幅 → 型号卡网格（图 + 全参数 + 详情）→ 品类说明。
 *
 * 参数只在型号卡里出现一次，卡片就是这个品类的参数出处。
 * 三列网格、卡片信息完整，客户在一屏半内能看完 7 个型号的所有关键参数。
 */
import Breadcrumb from '../seo/Breadcrumb.astro';
import ModelTile from '../cards/ModelTile.astro';
import CtaBand from '../layout/CtaBand.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath, ROUTES } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  categoryId: string;
  category: {
    name: string;
    intro: string;
    image?: string;
    comparisonParams: string[];
    selectionPoints: string[];
  };
  models: {
    id: string;
    code: string;
    status: 'active' | 'discontinued';
    cells: string[];
    image?: string;
  }[];
  discontinuedCount: number;
}

const { locale, crumbs, categoryId, category, models, discontinuedCount } = Astro.props;
const dict = t(locale);

/** 卡片参数 = 该品类的全部对比列（卡片是唯一出处） */
const tiles = models.map((m) => ({
  ...m,
  params: category.comparisonParams.map((label, i) => ({
    label,
    value: m.cells[i] ?? '—',
  })),
}));
---

<section class="cat-hero">
  <div class="container">
    <Breadcrumb items={crumbs} label={dict.breadcrumb.aria} />
    <div class="cat-hero-row">
      <h1>{category.name}</h1>
      <a class="cat-cta" href={localizePath(locale, ROUTES.quote)}>{dict.home.requestQuote}</a>
    </div>
    <p class="cat-facts">
      {dict.products.modelsUnit(models.length)} · {dict.category.paramsUnit(
        category.comparisonParams.length
      )}
      {discontinuedCount > 0 && ` · ${dict.category.discontinuedNote(discontinuedCount)}`}
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>{dict.category.modelsTitle}</h2>

    <ul class="model-grid">
      {
        tiles.map((m) => (
          <li>
            <ModelTile
              href={localizePath(locale, detailPath.model(categoryId, m.id))}
              code={m.code}
              status={m.status}
              discontinuedLabel={dict.category.discontinued}
              params={m.params}
              image={m.image}
              linkLabel={dict.category.detailLink}
              colon={locale === 'zh' ? '：' : ': '}
            />
          </li>
        ))
      }
    </ul>

    <div class="cat-about">
      <h2>{dict.category.about}</h2>
      <div class="cat-about-body">
        <p>{category.intro}</p>
        {
          category.selectionPoints.length > 0 && (
            <ul class="cat-points">
              {category.selectionPoints.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>

<CtaBand locale={locale} />

<style>
  /* 紧凑横幅：标题与询价同一行，规模信息一行 */
  .cat-hero {
    background: color-mix(in srgb, var(--color-brand-soft) 55%, var(--color-bg));
    border-bottom: 1px solid var(--color-border-brand);
    padding: var(--space-6) 0 var(--space-5);
  }

  .cat-hero-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin: var(--space-2) 0 var(--space-2);
  }

  .cat-hero-row h1 {
    margin: 0;
    color: var(--color-ink);
  }

  .cat-facts {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .cat-cta {
    flex-shrink: 0;
    padding: 12px 24px;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .cat-cta:hover {
    background: var(--color-brand-hover);
    color: #fff;
    text-decoration: none;
  }

  /* 型号网格：三列，卡片信息完整 */
  .model-grid {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .model-grid > li {
    flex: 0 0 calc((100% - 2 * var(--space-4)) / 3);
    max-width: calc((100% - 2 * var(--space-4)) / 3);
  }

  /* 说明：左右两栏，左标题右正文 */
  .cat-about {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--space-7);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-soft);
  }

  .cat-about h2 {
    margin-bottom: 0;
  }

  .cat-about-body p {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
  }

  .cat-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .cat-points li {
    position: relative;
    padding-left: 14px;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .cat-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--color-brand);
  }

  @media (max-width: 1024px) {
    .model-grid > li {
      flex: 0 0 calc((100% - var(--space-4)) / 2);
      max-width: calc((100% - var(--space-4)) / 2);
    }

    .cat-about {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  @media (max-width: 767px) {
    .model-grid > li {
      flex: 1 1 100%;
      max-width: 100%;
    }

    .cat-hero-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
