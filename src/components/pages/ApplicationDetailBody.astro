---
/**
 * 应用方向详情主体。
 *
 * 正文数据来自应用条目（经 applicationView 按语言回落），
 * 适用型号链接指向型号详情页。本组件不含取数与 SEO 装配。
 */
import PageHeader from '../layout/PageHeader.astro';
import DetailLayout from '../layout/DetailLayout.astro';
import SectionTitle from '../layout/SectionTitle.astro';
import ModelLinkList from '../catalog/ModelLinkList.astro';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/routing';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  application: {
    name: string;
    condition: string;
    criteria: string[];
    cautions: string[];
  };
  models: { id: string; categoryId: string; code: string; name: string }[];
}

const { locale, crumbs, application, models } = Astro.props;
const dict = t(locale);
---

<PageHeader locale={locale} crumbs={crumbs} title={application.name} width="narrow" />

<section class="section">
  <div class="container container-narrow">
    <DetailLayout>
      <div class="stack">
        <p class="intro">{application.condition}</p>

        <div>
          <SectionTitle title={dict.detail.criteria} />
          <ul class="points">
            {application.criteria.map((c) => <li>{c}</li>)}
          </ul>
        </div>

        {
          application.cautions.length > 0 && (
            <div>
              <SectionTitle title={dict.detail.cautions} />
              <ul class="points points--muted">
                {application.cautions.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <div slot="aside">
        <p class="aside-title">{dict.detail.recommendedModels}</p>
        <ModelLinkList locale={locale} models={models} />
      </div>
    </DetailLayout>
  </div>
</section>

<style>
  .stack {
    display: grid;
    gap: var(--space-8);
  }

  .intro {
    margin: 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  /* 匹配条件 / 注意事项：mono 序号 + 细线行，无彩色底 */
  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: point;
  }

  .points li {
    counter-increment: point;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  .points li::before {
    content: counter(point, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--ls-wide);
    color: var(--color-muted);
  }

  .points li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .points--muted li {
    color: var(--color-muted);
  }

  .aside-title {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
