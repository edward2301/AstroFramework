---
/**
 * 应用方向详情主体。
 *
 * 正文数据来自应用条目（经 applicationView 按语言回落），
 * 适用型号链接指向型号详情页。本组件不含取数与 SEO 装配。
 */
import PageHeader from '../layout/PageHeader.astro';
import DetailLayout from '../layout/DetailLayout.astro';
import SectionTitle from '../layout/SectionTitle.astro';
import ModelLinkList from '../catalog/ModelLinkList.astro';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/routing';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  application: {
    name: string;
    condition: string;
    criteria: string[];
    cautions: string[];
  };
  models: { id: string; categoryId: string; code: string; name: string }[];
}

const { locale, crumbs, application, models } = Astro.props;
const dict = t(locale);
---

<PageHeader locale={locale} crumbs={crumbs} title={application.name} width="narrow" />

<section class="section">
  <div class="container container-narrow">
    <DetailLayout>
      <div class="stack">
        <p class="intro">{application.condition}</p>

        <div>
          <SectionTitle title={dict.detail.criteria} />
          <ul class="points">
            {application.criteria.map((c) => <li>{c}</li>)}
          </ul>
        </div>

        {
          application.cautions.length > 0 && (
            <div>
              <SectionTitle title={dict.detail.cautions} />
              <ul class="points points--muted">
                {application.cautions.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <div slot="aside">
        <p class="aside-title">{dict.detail.recommendedModels}</p>
        <ModelLinkList locale={locale} models={models} />
      </div>
    </DetailLayout>
  </div>
</section>

