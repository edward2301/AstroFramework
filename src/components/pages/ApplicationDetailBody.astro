---
/**
 * 应用方向详情主体。
 *
 * 正文数据来自应用条目（经 applicationView 按语言回落），
 * 适用型号链接指向型号详情页。本组件不含取数与 SEO 装配。
 */
import PageHeader from '../layout/PageHeader.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  application: {
    name: string;
    condition: string;
    criteria: string[];
    cautions: string[];
  };
  models: { id: string; categoryId: string; code: string; name: string }[];
}

const { locale, crumbs, application, models } = Astro.props;
const dict = t(locale);
---

<PageHeader locale={locale} crumbs={crumbs} title={application.name} width="narrow" />

<section class="section">
  <div class="container container-narrow">
    <p class="intro">{application.condition}</p>

    <h2>{dict.detail.criteria}</h2>
    <ul class="points">
      {application.criteria.map((c) => <li>{c}</li>)}
    </ul>

    <h2>{dict.detail.recommendedModels}</h2>
    <ul class="model-links">
      {
        models.map((m) => (
          <li>
            <a href={localizePath(locale, detailPath.model(m.id))}>
              {m.code} — {m.name}
            </a>
          </li>
        ))
      }
    </ul>

    {
      application.cautions.length > 0 && (
        <>
          <h2>{dict.detail.cautions}</h2>
          <ul class="points cautions">
            {application.cautions.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </>
      )
    }

  </div>
</section>

<style>
  .intro {
    max-width: 760px;
  }

  .points {
    max-width: 760px;
  }

  .cautions li {
    color: var(--color-muted);
  }

  .model-links {
    max-width: 760px;
  }

  .model-links a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
