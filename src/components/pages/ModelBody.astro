---
/**
 * 型号页主体（工业数据目录版）。
 *
 * 布局：PageHeader（询价 + 资料按钮）→ 停产细线通知条 → 7/5 栏 hero
 * （左图 contain / 右关键参数 + 认证 chip）→ 技术规格（auto-fit 420px 网格）
 * → 尺寸与接口（细线定义网格）→ 相关（auto-fit 260px 网格）
 * → 页尾 CTA；≤1024 另有固定底部询价条。
 *
 * 取舍：图片与关键参数进首屏，规格表退到第二层；询价入口在页头与底部条出现，
 * 不插在参数与规格之间打断阅读。SEO/JSON-LD 与 quote URL 不变。
 */
import PageHeader from '../layout/PageHeader.astro';
import SectionTitle from '../layout/SectionTitle.astro';
import CtaBand from '../layout/CtaBand.astro';
import { t } from '../../i18n/ui';
import { localizePath, type Locale } from '../../i18n/routing';
import { detailPath, ROUTES } from '../../data/routes';
import type { Crumb } from '../../lib/seo/breadcrumb';

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  /** 主图公开路径（`public/` 下），由内容条目的 image 字段提供 */
  image?: string;
  model: {
    code: string;
    name: string;
    status: 'active' | 'discontinued';
    keyParams: { k: string; v: string }[];
    specGroups: { title: string; rows: { k: string; v: string }[] }[];
    dimensions?: string;
    interface?: string;
    certifications: string[];
  };
  /** 资料文件存在时才输出下载按钮，避免死链 */
  datasheet?: { path: string; available: boolean };
  replacements: { id: string; categoryId: string; code: string; name: string }[];
  applications: { id: string; name: string }[];
  cases: { id: string; title: string }[];
  /** 同品类其他型号（横向内链，用于型号间对比与抓取） */
  siblings: { id: string; categoryId: string; code: string }[];
}

const { locale, crumbs, model, image, datasheet, replacements, applications, cases, siblings } =
  Astro.props;
const dict = t(locale);

/** hero 与底部询价条共用的询价地址：保持现有 URL，不带 query */
const quoteHref = localizePath(locale, ROUTES.quote);
---

<PageHeader locale={locale} crumbs={crumbs} title={`${model.code} ${model.name}`}>
  <a class="btn btn--primary" slot="actions" href={quoteHref}>{dict.home.requestQuote}</a>
  {
    datasheet?.available && (
      <a class="btn btn--secondary" slot="actions" href={datasheet.path}>
        {dict.model.datasheet}
      </a>
    )
  }
</PageHeader>

<section class="section">
  <div class="container">
    {
      model.status === 'discontinued' && (
        <div class="notice">
          <strong>{dict.model.discontinuedTitle}</strong>
          {replacements.length > 0 ? dict.model.superseded : dict.model.support}
        </div>
      )
    }

    <div class="product-hero">
      {
        image && (
          <figure class="hero-media">
            <img
              src={image}
              alt={`${model.code} ${model.name}`}
              width="800"
              height="494"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )
      }

      <div class="product-side">
        <dl class="key-params">
          {
            model.keyParams.map((p) => (
              <div>
                <dt>{p.k}</dt>
                <dd class="mono">{p.v}</dd>
              </div>
            ))
          }
        </dl>

        {
          model.certifications.length > 0 && (
            <ul class="chip-list cert-chips" aria-label={dict.model.certifications}>
              {model.certifications.map((c) => (
                <li class="chip">{c}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <SectionTitle title={dict.model.specs} />
    <div class="spec-grid">
      {
        model.specGroups.map((group) => (
          <div class="spec-group">
            <h3>{group.title}</h3>
            <div class="table-scroll" tabindex="0" role="region" aria-label={group.title}>
              <table class="spec-table">
                <tbody>
                  {group.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.k}</th>
                      <td>{row.v}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>

    {
      (model.dimensions || model.interface) && (
        <>
          <SectionTitle title={dict.model.dimensionsAndCompliance} />
          <dl class="facts">
            {model.dimensions && (<><dt>{dict.model.dimensions}</dt><dd>{model.dimensions}</dd></>)}
            {model.interface && (<><dt>{dict.model.interface}</dt><dd>{model.interface}</dd></>)}
          </dl>
        </>
      )
    }

    {
      (replacements.length > 0 ||
        applications.length > 0 ||
        cases.length > 0 ||
        siblings.length > 0) && (
        <SectionTitle title={dict.section.related} />
      )
    }

    <div class="related-groups">
      {
        replacements.length > 0 && (
          <section class="related-group">
            <h3>{dict.model.replacement}</h3>
            <ul class="related">
              {replacements.map((r) => (
                <li>
                  <a href={localizePath(locale, detailPath.model(r.id))}>
                    {r.code} {r.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        applications.length > 0 && (
          <section class="related-group">
            <h3>{dict.model.applications}</h3>
            <ul class="related">
              {applications.map((a) => (
                <li>
                  <a href={localizePath(locale, detailPath.application(a.id))}>{a.name}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        cases.length > 0 && (
          <section class="related-group">
            <h3>{dict.model.relatedCases}</h3>
            <ul class="related">
              {cases.map((c) => (
                <li>
                  <a href={localizePath(locale, detailPath.caseStudy(c.id))}>{c.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        siblings.length > 0 && (
          <section class="related-group">
            <h3>{dict.model.otherModels}</h3>
            <ul class="chip-list sibling-chips">
              {siblings.map((m) => (
                <li>
                  <a class="chip mono" href={localizePath(locale, detailPath.model(m.id))}>
                    {m.code}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</section>

<CtaBand locale={locale} />

{/* ≤1024 固定底部询价条：型号编码 + 询价按钮；桌面隐藏 */}
<div class="quote-bar">
  <span class="quote-bar-code mono">{model.code}</span>
  <a class="btn btn--primary btn--sm" href={quoteHref}>{dict.home.requestQuote}</a>
</div>

<style>
  /* 停产通知：上下 1px 细线的通栏条，不做卡片 */
  .notice {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-left: 0;
    background: transparent;
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }

  .notice strong {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  /* 首屏 7/5 栏：左图（黄金比、contain）+ 右信息（参数与认证 chip） */
  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-7);
    align-items: stretch;
    margin-bottom: var(--space-8);
  }

  .hero-media {
    width: 100%;
    max-width: 960px;
    margin: 0;
  }

  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.618;
    object-fit: contain;
    border: 1px solid var(--color-border);
    background: var(--color-sunken);
  }

  .product-side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
  }

  /* 关键参数：两列，顶部细线分格，值用等宽 */
  .key-params {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-6);
    margin: 0;
  }

  .key-params div {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .key-params dt {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    color: var(--color-muted);
  }

  .key-params dd {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-data);
    font-weight: 600;
    color: var(--color-ink);
  }

  /* 认证 chip：reset 走全局 .chip-list，无其余专有样式 */

  /* 规格：auto-fit 网格，组标题小号大写，表格行更紧 */
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: var(--space-6) var(--space-7);
    margin-bottom: var(--space-8);
  }

  .spec-group {
    min-width: 0;
  }

  .spec-group h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .spec-table {
    border-top: 1px solid var(--color-border);
  }

  .spec-table th,
  .spec-table td {
    padding: 6px 10px;
    line-height: var(--lh-data);
  }

  /* 尺寸与接口：max-content / 1fr 定义网格，行间细线 */
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0;
    margin: 0 0 var(--space-8);
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-sm);
  }

  .facts dt,
  .facts dd {
    margin: 0;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .facts dt {
    padding-right: var(--space-6);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .facts dd {
    font-variant-numeric: tabular-nums;
  }

  /* 相关：auto-fit 网格，组标题小号大写，条目按细线行排列 */
  .related-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-6) var(--space-7);
  }

  .related-group {
    min-width: 0;
  }

  .related-group h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .related li {
    border-top: 1px solid var(--color-border);
  }

  .related a {
    display: block;
    padding: var(--space-3) 0;
    font-size: var(--fs-sm);
  }

  /* 同品类其他型号：方形 chip，编码等宽（reset 走全局 .chip-list） */
  .sibling-chips .chip {
    text-decoration: none;
    color: var(--color-link);
  }

  /* 移动端同品类型号 chip：38×33 → 44×44 */
  @media (max-width: 768px) {
    .sibling-chips .chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      padding: 0 var(--space-3);
    }
  }

  .sibling-chips .chip:hover {
    border-color: var(--color-link);
    color: var(--color-link-hover);
    text-decoration: none;
  }

  /* 固定底部询价条：仅 ≤1024 出现；高度 56px + 底部安全区 */
  .quote-bar {
    display: none;
  }

  @media (max-width: 1024px) {
    .product-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .quote-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: var(--z-sticky);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      height: calc(56px + env(safe-area-inset-bottom));
      padding: 0 var(--gutter) env(safe-area-inset-bottom);
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    /* 固定询价条里的按钮同样保持 44px 触控高度 */
    .quote-bar .btn {
      min-height: 44px;
    }

    /* 页脚最后几行不被固定条遮住 */
    :global(body:has(.quote-bar)) {
      padding-bottom: calc(56px + env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 768px) {
    .key-params {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
