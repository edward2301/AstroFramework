---
/**
 * 品类横排：大图 + 标题 + 简介 + 描边按钮，隔行翻转图片位置。
 *
 * 产品总览页的品类展示形态——与首页的轮播卡片（CategoryCard）刻意不同：
 * 总览是「目录页」，用大图横排逐个介绍；首页是「精选层」，用小卡轮播。
 * 图片缺省时退化为纯文字行（当前 27/27 型号都有图，不会发生）。
 */
interface Props {
  href: string;
  name: string;
  /** 简介文本；截断与省略号由调用方决定 */
  intro: string;
  /** 按钮文案，由调用方按语境传（如「7 个型号 · 查看型号 →」） */
  linkLabel: string;
  /** 品类封面图（取该品类首个型号的主图） */
  image?: string;
  /** 偶数行图片放右侧，形成斑马节奏 */
  flip?: boolean;
}

const { href, name, intro, linkLabel, image, flip = false } = Astro.props;
---

<div class:list={['category-row', flip && 'category-row--flip']}>
  {
    image && (
      <img
        class="category-row-media"
        src={image}
        alt={name}
        width="1200"
        height="742"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="category-row-body">
    <h2>{name}</h2>
    <p>{intro}</p>
    <a class="category-row-link" href={href}>{linkLabel}</a>
  </div>
</div>

<style>
  .category-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: center;
  }

  /* 隔行翻转：偶数行图片移到右侧 */
  .category-row--flip .category-row-media {
    order: 2;
  }

  .category-row-media {
    width: 100%;
    height: auto;
    aspect-ratio: 1.618; /* 黄金比：与型号占位图同一标准 */
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .category-row-body h2 {
    margin-bottom: var(--space-3);
    color: var(--color-ink);
  }

  /* 文字列限宽：行宽不超过 520px，避免与图片并排时句子拉得过长 */
  .category-row-body {
    max-width: 520px;
  }

  .category-row-body p {
    color: var(--color-text-muted);
  }

  /* 按钮：浅品牌底 + 品牌文字（一眼看出可点），悬停实底 */
  .category-row-link {
    display: inline-block;
    margin-top: var(--space-4);
    padding: 10px 24px;
    border: 1px solid color-mix(in srgb, var(--color-brand) 28%, transparent);
    border-radius: 999px;
    background: var(--color-brand-soft);
    color: var(--color-brand);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .category-row-link:hover {
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: #fff;
    text-decoration: none;
  }

  /* 图片悬停改边色：与卡片交互语言一致（轻微，不位移） */
  .category-row-media {
    transition: border-color 0.15s ease;
  }

  .category-row:hover .category-row-media {
    border-color: color-mix(in srgb, var(--color-brand) 45%, var(--color-border));
  }

  @media (max-width: 767px) {
    .category-row {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    /* 窄屏单列时图片恒在文字上方，不翻转 */
    .category-row--flip .category-row-media {
      order: 0;
    }
  }
</style>
