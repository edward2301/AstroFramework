---
/**
 * 品类目录行（工业数据目录版）：280px 图 + 标题 + 简介 + 按钮，无左右交替。
 *
 * 产品总览页的品类展示形态——与首页的网格卡片（CategoryCard）刻意不同：
 * 总览是「目录页」，用紧凑行逐个介绍；首页是「精选层」，用卡片网格。
 * 图片缺省时退化为纯文字行（当前 27/27 型号都有图，不会发生）。
 */
interface Props {
  href: string;
  name: string;
  /** 简介文本；截断与省略号由调用方决定 */
  intro: string;
  /** 按钮文案，由调用方按语境传（如「7 个型号 · 查看型号 →」） */
  linkLabel: string;
  /** 品类封面图（取该品类首个型号的主图） */
  image?: string;
}

const { href, name, intro, linkLabel, image } = Astro.props;
---

<div class="category-row">
  {
    image && (
      <img
        class="category-row-media"
        src={image}
        alt={name}
        width="1200"
        height="742"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="category-row-body">
    <h2>{name}</h2>
    <p>{intro}</p>
    <a class="category-row-link btn btn--secondary" href={href}>{linkLabel}</a>
  </div>
</div>

<style>
  /* 紧凑目录行：280px 图 + 内容；图是目录缩略，不是展示位 */
  .category-row {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }

  .category-row-media {
    width: 100%;
    height: auto;
    aspect-ratio: 1.618; /* 黄金比：与型号占位图同一标准 */
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    transition: border-color var(--duration-1) var(--ease);
  }

  .category-row:hover .category-row-media {
    border-color: var(--color-border-brand);
  }

  .category-row-body h2 {
    margin-bottom: var(--space-3);
    color: var(--color-ink);
  }

  /* 文字列限宽：行宽不超过 520px，避免句子拉得过长 */
  .category-row-body {
    max-width: 520px;
  }

  .category-row-body p {
    color: var(--color-muted);
  }

  /* 间距归本组件管：按钮外观由全局 .btn--secondary 提供 */
  .category-row-link {
    margin-top: var(--space-4);
  }

  @media (max-width: 767px) {
    .category-row {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
