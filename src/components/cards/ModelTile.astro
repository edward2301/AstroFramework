---
/**
 * 品类页型号瓦片：方形图区 + 编码 + 状态 + 详情链接。
 *
 * 参数的唯一出处是对比表；compact 形态只出图 + 编码 + 状态 + 链接，
 * 非 compact 仍保留参数列表（当前仅品类页使用 compact）。
 */
interface Props {
  href: string;
  code: string;
  /** 型号名；品类页瓦片需要它，只有编码会显得太空 */
  name?: string;
  status: 'active' | 'discontinued';
  discontinuedLabel: string;
  params: { label: string; value: string }[];
  image?: string;
  linkLabel: string;
  /** 标签后的冒号：中文用「：」，英文用「: 」 */
  colon: string;
  /** 次级形态：只出图 + 编码 + 状态 + 详情链接，不重复参数（参数出处是对比表） */
  compact?: boolean;
}

const { href, code, name, status, discontinuedLabel, params, image, linkLabel, colon, compact = false } =
  Astro.props;
const discontinued = status === 'discontinued';
/** 替代文本用已知信息拼出具体规格，避免只留一个型号编码 */
const imageAlt = name ? `${code} ${name}` : params.length > 0 ? `${code} ${params[0].label} ${params[0].value}` : code;
---

<article class:list={['model-tile', discontinued && 'is-discontinued']}>
  {
    image && (
      <div class="tile-media">
        <img src={image} alt={imageAlt} width="800" height="494" loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class="tile-body">
    <div class="tile-head">
      <h3 class="mono">{code}</h3>
      {discontinued && <span class="badge">{discontinuedLabel}</span>}
    </div>
    {name && <p class="tile-name">{name}</p>}
    {
      !compact && params.length > 0 && (
        <dl class="tile-params">
          {params.map((p) => (
            <div>
              <dt>{p.label}{colon}</dt>
              <dd>{p.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <a class="tile-link" href={href}>{linkLabel}</a>
  </div>
</article>

<style>
  .model-tile {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: border-color var(--duration-1) var(--ease);
  }

  /* 只加深 1px 细线，不做阴影/位移 */
  .model-tile:hover {
    border-color: var(--color-border-strong);
  }

  /* 方形图区：图 contain 居中，底部一条细线接文字区 */
  .tile-media {
    aspect-ratio: 1 / 1;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .tile-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .is-discontinued .tile-media img {
    filter: grayscale(1);
    opacity: 0.7;
  }

  .tile-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-4);
  }

  .tile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tile-head h3 {
    margin: 0;
    font-size: var(--fs-data);
    font-weight: 600;
    line-height: var(--lh-data);
    color: var(--color-ink);
  }

  .tile-name {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  /* 参数：两列紧凑排布（非 compact 形态才会出现） */
  .tile-params {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 0;
  }

  .tile-params div {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }

  dt {
    flex-shrink: 0;
    font-size: var(--fs-xs);
    color: var(--color-muted);
  }

  dd {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tile-link {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-soft);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-link);
  }

  .tile-link:hover {
    color: var(--color-link-hover);
  }

  /* 2 列移动端：收紧内边距与字号，保证 165px 宽的瓦片仍能放下编码/名称/链接 */
  @media (max-width: 768px) {
    .tile-body {
      padding: var(--space-3);
    }

    .tile-head h3 {
      font-size: var(--fs-sm);
    }

    .tile-name {
      font-size: var(--fs-xs);
    }

    .tile-link {
      display: flex;
      align-items: center;
      min-height: 44px;
      font-size: var(--fs-xs);
    }
  }
</style>
