---
/**
 * 机型卡：通栏主图 + 等宽编码 + 型号名 + 首参数。
 *
 * 图上文下、直角、1px 细线；悬停只换边框色（不位移、不投影、不放大）。
 * 唯一可点目标是型号名链接；图片与参数不参与点击。使用方：首页「常用型号」。
 */
interface Props {
  href: string;
  /** 型号编码（等宽显示） */
  code: string;
  /** 型号名；作为卡片 h3 与链接文案 */
  name: string;
  /** 首参数的键名（如「量程 / Range」），与参数值成对展示 */
  firstParamLabel: string;
  firstParam: string;
  /** 主图公开路径（public/ 下），缺省时不输出图片 */
  image?: string;
}

const { href, code, name, firstParamLabel, firstParam, image } = Astro.props;
---

<div class="model-card">
  {
    image && (
      <img
        class="model-card-img"
        src={image}
        alt={`${code} ${name}`}
        width="800"
        height="494"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="model-card-body">
    <p class="model-card-code mono">{code}</p>
    <h3 class="model-card-name"><a href={href}>{name}</a></h3>
    <dl class="model-card-param">
      <dt>{firstParamLabel}</dt>
      <dd class="mono">{firstParam}</dd>
    </dl>
  </div>
</div>

<style>
  .model-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: border-color var(--duration-1) var(--ease);
  }

  /* 唯一的悬停反馈：细线加深 */
  .model-card:hover {
    border-color: var(--color-border-strong);
  }

  /* 通栏主图：height:auto 必须显式声明，否则 height="494" 属性会盖掉比例 */
  .model-card-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.618;
    object-fit: cover;
  }

  .model-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5);
  }

  .model-card-code {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  h3 {
    margin: 0;
    font-size: var(--fs-h3);
    letter-spacing: var(--ls-tight);
  }

  .model-card-name a:hover {
    color: var(--color-link-hover);
  }

  /* 型号名是卡片唯一入口：移动端补到 44px 触控高度 */
  @media (max-width: 768px) {
    .model-card-name a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  /* 一个参数：细线上方一行 k/v */
  .model-card-param {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .model-card-param dt {
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .model-card-param dd {
    margin: 0;
    min-width: 0;
    font-size: var(--fs-data);
    line-height: var(--lh-data);
    color: var(--color-text);
    text-align: right;
    overflow-wrap: anywhere;
  }
</style>
