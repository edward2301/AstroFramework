---
/**
 * 机型卡：左文（编码 + 首参数，归拢居中）+ 右图。
 *
 * 图片文件本身是黄金比（800x494），卡片高度自然由图片撑出——
 * 不设 min-height、不设卡片比例、不做拉伸：比例永远等于源图，零裁切零白缝。
 * 唯一可点目标是型号名链接；图片与参数不参与点击。使用方：首页「常用型号」轮播。
 */
interface Props {
  href: string;
  code: string;
  /** 首参数的键名（如「量程 / Range」），与参数值成对展示 */
  firstParamLabel: string;
  firstParam: string;
  /** 主图公开路径（public/ 下），缺省时不输出图片 */
  image?: string;
}

const { href, code, firstParamLabel, firstParam, image } = Astro.props;
---

<div class="model-card">
  <div class="model-card-body">
    <a class="model-card-code" href={href}>
      <strong>{code}</strong>
    </a>
    <em>{firstParamLabel} · {firstParam}</em>
  </div>
  {
    image && (
      <img
        class="model-card-img"
        src={image}
        alt={`${code} ${firstParamLabel} ${firstParam}`}
        width="800"
        height="494"
        loading="lazy"
        decoding="async"
      />
    )
  }
</div>

<style>
  .model-card {
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .model-card:hover {
    border-color: var(--color-brand);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  /* 左文：编码与参数归拢为一组、整组垂直居中（卡片高度=图片高度） */
  .model-card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    padding: var(--space-4) var(--space-5);
    color: inherit;
  }

  /* 唯一可点目标：型号名链接；参数与图片不跳转 */
  .model-card-code {
    align-self: flex-start;
    color: inherit;
    text-decoration: none;
  }

  .model-card-code:hover strong {
    color: var(--color-brand);
  }

  strong {
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .model-card-code strong::after {
    content: '';
    display: block;
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-brand);
    margin-top: 10px;
  }

  /* 参数行单行不折：折行会把卡片撑高、把右侧图片拉成方形 */
  em {
    font-style: normal;
    font-size: var(--fs-xs);
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /*
   * 右图：宽 55%，高度 = 宽 ÷ 1.618（黄金比）。
   * align-self: center 是必须的——卡片的 align-items 会把图拉伸到卡片高度，
   * 一旦文字行变高或同行卡片被拉齐，比例就会被破坏（之前就是这样变成方形的）。
   */
  .model-card-img {
    display: block;
    flex: 0 0 55%;
    width: 55%;
    height: auto;
    aspect-ratio: 1.618;
    align-self: center;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  /* 悬停微放大：产品卡标配微交互 */
  .model-card:hover .model-card-img {
    transform: scale(1.04);
  }
</style>
