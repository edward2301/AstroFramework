---
/**
 * 品类卡：封面图（黄金比通栏）+ 品类名 + 简介 + 显式链接。
 *
 * 点击行为收窄在链接上（图与卡体不跳转），悬停高亮保留在整卡。
 * 使用方：首页品类轮播、产品总览列表。
 */
interface Props {
  href: string;
  name: string;
  /** 简介文本；截断与省略号由调用方决定 */
  intro: string;
  /** 链接文案，由调用方按语境传（如「查看型号 →」「6 个型号 · 查看系列 →」） */
  linkLabel: string;
  /** 品类封面图（public/ 下，黄金比 1.618），缺省时不输出图片 */
  image?: string;
}

const { href, name, intro, linkLabel, image } = Astro.props;
---

<div class="category-card">
  {
    image && (
      <img
        class="category-card-img"
        src={image}
        alt={name}
        width="1200"
        height="742"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="category-card-body">
    <h3>{name}</h3>
    <p>{intro}</p>
    <a class="category-card-link" href={href}>{linkLabel}</a>
  </div>
</div>

<style>
  .category-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    height: 100%;
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color var(--duration-1) var(--ease), box-shadow var(--duration-1) var(--ease),
      transform var(--duration-1) var(--ease);
  }

  .category-card:hover {
    border-color: var(--color-action);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* 封面：通栏黄金比。height:auto 必须显式声明，否则 height="742" 属性会盖掉比例 */
  .category-card-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.618;
    object-fit: cover;
    transition: transform var(--duration-3) var(--ease);
  }

  /* 悬停微放大：产品卡标配微交互 */
  .category-card:hover .category-card-img {
    transform: scale(1.04);
  }

  /* 文字区：32px 四周留白，与图片、边框都有呼吸距离 */
  .category-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-6);
  }

  h3 {
    margin-bottom: var(--space-3);
    letter-spacing: var(--ls-tight);
    transition: color var(--duration-1) var(--ease);
  }

  .category-card:hover h3 {
    color: var(--color-action);
  }

  p {
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  .category-card-link {
    display: inline-block;
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-link);
    transition: transform var(--duration-1) var(--ease), color var(--duration-1) var(--ease);
  }

  .category-card-link:hover {
    color: var(--color-link-hover);
  }

  .category-card:hover .category-card-link {
    transform: translateX(3px);
  }

  /* 手机：卡片窄，文字区内边距收一档 */
  @media (max-width: 767px) {
    .category-card-body {
      padding: var(--space-5);
    }
  }
</style>
