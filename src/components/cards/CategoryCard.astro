---
/**
 * 品类卡：封面图（通栏）+ 品类名 + 简介 + 显式链接。
 *
 * 图上文下、直角、1px 细线；悬停只换边框色（不位移、不投影、不放大）。
 * 点击行为收窄在链接上（图与卡体不跳转）。
 * 使用方：首页品类网格。
 */
interface Props {
  href: string;
  name: string;
  /** 简介文本；截断与省略号由调用方决定 */
  intro: string;
  /** 链接文案，由调用方按语境传（如「查看型号 →」） */
  linkLabel: string;
  /** 品类封面图（public/ 下，黄金比 1.618），缺省时不输出图片 */
  image?: string;
}

const { href, name, intro, linkLabel, image } = Astro.props;
---

<div class="category-card">
  {
    image && (
      <img
        class="category-card-img"
        src={image}
        alt={name}
        width="1200"
        height="742"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="category-card-body">
    <h3>{name}</h3>
    <p>{intro}</p>
    <a class="category-card-link" href={href}>{linkLabel}</a>
  </div>
</div>

<style>
  .category-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    height: 100%;
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color var(--duration-1) var(--ease);
  }

  /* 唯一的悬停反馈：细线加深 */
  .category-card:hover {
    border-color: var(--color-border-strong);
  }

  /* 封面：通栏黄金比。height:auto 必须显式声明，否则 height="742" 属性会盖掉比例 */
  .category-card-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.618;
    object-fit: cover;
  }

  .category-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5);
  }

  h3 {
    margin-bottom: var(--space-3);
  }

  p {
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--color-muted);
  }

  .category-card-link {
    display: inline-block;
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-link);
  }

  .category-card-link:hover {
    color: var(--color-link-hover);
  }

  /* 卡片入口链接：移动端补到 44px 触控高度 */
  @media (max-width: 768px) {
    .category-card-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
